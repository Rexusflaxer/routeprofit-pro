{
  "name": "CAORule",
  "type": "object",
  "properties": {
    "rule_id": {
      "type": "string",
      "description": "Uniek rule ID, bijv. CAO-PB-2024-R0315"
    },
    "cao_key": {
      "type": "string",
      "description": "CAO sleutel, bijv. cao_particuliere_beveiliging"
    },
    "version_label": {
      "type": [
        "string",
        "null"
      ],
      "description": "Versielabel van de CAO"
    },
    "source_pdf": {
      "type": [
        "string",
        "null"
      ],
      "description": "Bronbestand PDF"
    },
    "source_document_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Gekoppeld CAOSourceDocument ID"
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonieke URL van de bronregel wanneer geen CAOSourceDocument ID beschikbaar is"
    },
    "document_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "Directe document-URL van de bron, bijvoorbeeld PDF/XLSX"
    },
    "source_reference": {
      "type": [
        "string",
        "null"
      ],
      "description": "Leesbare bronverwijzing, bijvoorbeeld artikel, bijlage, pagina, tabel of vraagbaak-item"
    },
    "pdf_page_start": {
      "type": [
        "number",
        "null"
      ]
    },
    "pdf_page_end": {
      "type": [
        "number",
        "null"
      ]
    },
    "source_page_label": {
      "type": [
        "string",
        "null"
      ],
      "description": "Pagina- of tabel-label zoals in de bron vermeld"
    },
    "source_line_start": {
      "type": [
        "number",
        "null"
      ]
    },
    "source_line_end": {
      "type": [
        "number",
        "null"
      ]
    },
    "source_paragraph": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_anchor": {
      "type": [
        "string",
        "null"
      ],
      "description": "Stabiele anchor binnen bronextractie, bijvoorbeeld HTML id, tabelcel of tekstfragment-id"
    },
    "chapter": {
      "type": [
        "string",
        "null"
      ]
    },
    "article": {
      "type": [
        "string",
        "null"
      ]
    },
    "appendix": {
      "type": [
        "string",
        "null"
      ]
    },
    "protocol": {
      "type": [
        "string",
        "null"
      ]
    },
    "domain": {
      "type": [
        "string",
        "null"
      ],
      "description": "Domein bijv. payroll_wages_allowances, contract_employment, leave_holidays"
    },
    "impact": {
      "type": [
        "string",
        "null"
      ],
      "description": "Impact type bijv. automatic_or_calculation, reference_or_context"
    },
    "automation_level": {
      "type": "string",
      "enum": [
        "automatic_or_calculation",
        "validation_or_policy",
        "workflow_or_documentation",
        "reference_or_policy",
        "reference"
      ],
      "default": "reference"
    },
    "implementation_status": {
      "type": "string",
      "enum": [
        "IMPLEMENTED",
        "PARTIAL",
        "MISSING",
        "REFERENCE"
      ],
      "default": "MISSING"
    },
    "manual_review_required": {
      "type": "boolean",
      "default": false
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "low"
    },
    "rule_text": {
      "type": [
        "string",
        "null"
      ],
      "description": "Volledige regeltekst"
    },
    "rule_text_summary": {
      "type": [
        "string",
        "null"
      ],
      "description": "Samenvatting van de regel"
    },
    "sha1": {
      "type": [
        "string",
        "null"
      ],
      "description": "SHA1 hash van de bronregel"
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "description": "SHA-256 hash van de bronregel"
    },
    "source_hash": {
      "type": [
        "string",
        "null"
      ],
      "description": "Hash van het brondocument of bronfragment dat aan deze regel is gekoppeld"
    },
    "rule_hash": {
      "type": [
        "string",
        "null"
      ],
      "description": "Hash van de genormaliseerde regelrepresentatie"
    },
    "rule_text_hash": {
      "type": [
        "string",
        "null"
      ],
      "description": "Hash van rule_text of rule_text_summary"
    },
    "hash_algorithm": {
      "type": [
        "string",
        "null"
      ],
      "description": "Hash-algoritme voor de aangeleverde regelhashes"
    },
    "source_evidence": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Machineleesbare audit-evidence voor de herkomst van deze CAO-regel"
    },
    "source_evidence_confidence": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "high",
        "medium",
        "low",
        "unknown",
        null
      ],
      "description": "Betrouwbaarheid van de bronkoppeling"
    },
    "applies_when": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Condities waaronder de regel van toepassing is"
    },
    "default_action": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "validation_action": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "calculation_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "automatic",
        "manual_review_required",
        "policy_only",
        "not_payroll",
        null
      ]
    },
    "implemented_in": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lijst van functies/componenten waar deze regel is ge\u00efmplementeerd"
    },
    "runtime_binding_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "verified_local_runtime",
        "missing_local_runtime",
        "not_required",
        "unknown",
        null
      ],
      "description": "Lokale Base44 runtime-verificatie. IMPLEMENTED telt pas als payroll-safe als deze verified_local_runtime is."
    },
    "runtime_binding_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Lokale runtime binding key, bijv. applyCaoContractRules.probation_and_probation_dismissal."
    },
    "runtime_binding_functions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Base44 functions die deze regel daadwerkelijk toepassen of valideren."
    },
    "local_runtime_verified_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO datetime waarop de lokale runtime-binding voor deze regel is vastgesteld."
    },
    "tests": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "last_verified_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "cao_configuration_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "active",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "rule_id",
    "cao_key"
  ]
}
