{
  "name": "SurveillanceObject",
  "type": "object",
  "properties": {
    "object_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "description": "Door de gebruiker beheerde, hoofdletterongevoelig unieke interne objectcode"
    },
    "object_code_normalized": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 50,
      "description": "Technische NFKC/hoofdletter-normalisatie voor eenduidige objectcodecontrole en zoekacties"
    },
    "external_object_code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120,
      "description": "Niet-unieke referentiecode van bijvoorbeeld opdrachtgever, hoofdaannemer of ander beveiligingsbedrijf"
    },
    "external_object_code_normalized": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120,
      "description": "Technische NFKC/hoofdletter-normalisatie waarmee op de externe objectcode kan worden gezocht"
    },
    "creation_idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Technische sleutel waarmee herhaalde create-verzoeken hetzelfde object opleveren"
    },
    "creation_request_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "description": "SHA-256-fingerprint van het canonieke create-verzoek voor gebonden partial-create recovery"
    },
    "creation_actor_user_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Backofficegebruiker aan wie de create-idempotency-sleutel is gebonden"
    },
    "creation_mutation_target": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonieke klant/object-create target voor gebonden partial-create recovery"
    },
    "object_key_mutation_lock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Kortdurend objectgebonden slot dat sleutelmutaties atomair serialiseert."
    },
    "object_key_mutation_lock_version": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Onafhankelijke CAS-versie voor het sleutelmutatieslot; wijzigt de dossier-versie niet."
    },
    "relationship_mutation_lock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Kortdurend objectgebonden slot dat relatiemutaties atomair serialiseert."
    },
    "relationship_mutation_lock_version": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Onafhankelijke CAS-versie voor het relatiemutatieslot; wijzigt de dossier-versie niet."
    },
    "warning_address_mutation_lock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Kortdurend objectgebonden slot dat waarschuwingsadresmutaties atomair serialiseert."
    },
    "warning_address_mutation_lock_version": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Onafhankelijke CAS-versie voor het waarschuwingsadresslot; wijzigt de dossier-versie niet."
    },
    "warning_address_order_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Canonieke, objectbrede belvolgorde van niet-gearchiveerde waarschuwingsadressen."
    },
    "warning_address_order_version": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Onafhankelijke CAS-versie voor de canonieke belvolgorde."
    },
    "warning_address_order_updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "warning_address_last_mutation_key_hash": {
      "type": [
        "string",
        "null"
      ],
      "description": "Hash van de laatste atomisch afgeronde waarschuwingsadres-volgordemutatie"
    },
    "warning_address_last_mutation_recovery": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "warning_address_mutation_key_hashes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "warning_address_mutation_recoveries": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "installation_mutation_lock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Kortdurend objectgebonden slot dat installatiemutaties atomair serialiseert."
    },
    "installation_mutation_lock_version": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Onafhankelijke CAS-versie voor het installatiemutatieslot; wijzigt de dossier-versie niet."
    },
    "security_plan_mutation_lock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Gedeeld kortdurend objectslot dat plan-, sectie-, module- en legacy-planmutaties atomair serialiseert."
    },
    "security_plan_mutation_lock_version": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Onafhankelijke CAS-versie voor het beveiligingsplanslot; wijzigt de dossier-versie niet."
    },
    "operational_module_mutation_lock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Legacy moduleslot; nieuwe modulemutaties gebruiken het gedeelde security_plan_mutation_lock om planlinks en modulestatus atomair te serialiseren."
    },
    "operational_module_mutation_lock_version": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Legacy CAS-versie voor het voormalige afzonderlijke objectmoduleslot; blijft uitsluitend voor compatibiliteit bestaan."
    },
    "customer_platform_last_mutation_key_hash": {
      "type": [
        "string",
        "null"
      ],
      "description": "SHA-256-hash van de laatste gecontroleerde objectmutatie; uitsluitend voor idempotent crashherstel"
    },
    "customer_platform_last_mutation_recovery": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Gesanitiseerde technische recovery-marker die atomair met de laatste objectmutatie wordt opgeslagen"
    },
    "customer_platform_mutation_key_hashes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Begrensde hashes van de laatste gecontroleerde objectmutaties voor crashherstel en idempotency-binding"
    },
    "customer_platform_mutation_recoveries": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Gesanitiseerd, begrensd recoverylog per mutatiehash; voorkomt dat een directe opvolger een nog niet geaudite mutatie overschrijft"
    },
    "customer_id": {
      "type": "string",
      "description": "ID van de gekoppelde klant"
    },
    "object_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "office",
        "retail_hospitality",
        "industrial_logistics",
        "construction_site",
        "healthcare_education",
        "residential",
        "event_temporary",
        "parking",
        "other",
        null
      ],
      "description": "Functioneel locatietype; bepaalt alleen de vervolgconfiguratie"
    },
    "status": {
      "type": "string",
      "enum": [
        "concept",
        "active",
        "inactive",
        "archived"
      ],
      "description": "Kleine objectlevenscyclus; operationele readiness wordt afzonderlijk bepaald"
    },
    "archived_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Tijdstip waarop het object gecontroleerd is gearchiveerd"
    },
    "archived_by_user_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Backofficegebruiker die het object heeft gearchiveerd"
    },
    "archive_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Verplichte reden voor archivering; blijft onderdeel van de historie"
    },
    "region": {
      "type": [
        "string",
        "null"
      ],
      "description": "Operationele regio voor zoeken en latere planning"
    },
    "cao_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Default CAO-key voor diensten op dit object wanneer taak/planning geen specifiekere CAO-key meegeeft"
    },
    "default_service_function_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Default functietype voor diensten op dit object, bijvoorbeeld surveillant, receptioniste of klantrelatie"
    },
    "default_cao_function_group": {
      "type": [
        "string",
        "null"
      ],
      "description": "Default CAO-functiegroep voor diensten op dit object"
    },
    "default_cao_function_level": {
      "type": [
        "string",
        "null"
      ],
      "description": "Default CAO-functieniveau voor diensten op dit object"
    },
    "default_security_role_status": {
      "type": [
        "string",
        "null"
      ],
      "description": "Default beveiligingsstatus voor diensten op dit object, bijvoorbeeld aspirant_beveiliger of beveiliger"
    },
    "default_required_qualification_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Default kwalificatie-/diplomatypes voor diensten op dit object."
    },
    "default_required_qualification_groups": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Default kwalificatiegroepen voor diensten op dit object, bijvoorbeeld base_security, advanced_security, ehbo_or_bhv of centralist_basic."
    },
    "default_required_security_pass_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "grey",
          "green",
          "temporary",
          "other"
        ]
      },
      "default": [],
      "description": "Default beveiligingspastypes die voor diensten op dit object verplicht zijn."
    },
    "default_performs_security_work": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Default of diensten op dit object feitelijk beveiligingswerk zijn"
    },
    "default_security_work_percentage": {
      "type": [
        "number",
        "null"
      ],
      "description": "Default percentage beveiligingswerk voor diensten op dit object"
    },
    "default_works_event_or_hospitality_security": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Default of diensten op dit object evenementen- of horecabeveiliging betreffen"
    },
    "default_event_hospitality_cao_applies": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Default of voor diensten op dit object de evenementen-/horecabeveiligings-CAO geldt"
    },
    "default_works_airport_schiphol": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Default of diensten op dit object onder Schiphol/airport-context vallen"
    },
    "default_works_cash_value_logistics": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Default of diensten op dit object geld- en waardelogistiek betreffen"
    },
    "default_customer_billable": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Default of diensten op dit object klantfacturabel zijn"
    },
    "default_counts_toward_required_staffing": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Default of diensten op dit object meetellen voor verplichte bezetting"
    },
    "contract_assignment_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "strict_contract_match",
        "allow_manual_review",
        null
      ],
      "description": "Default contractmatchingbeleid voor diensten op dit object"
    },
    "default_operating_company_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Default werkgever/bedrijf dat diensten op dit object uitvoert wanneer taak/route geen specifieker bedrijf meegeeft."
    },
    "name": {
      "type": "string",
      "description": "Naam van het object/locatie"
    },
    "logo_file_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "Weergave-URL van het objectlogo"
    },
    "logo_file_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "ManagedFile ID van het objectlogo"
    },
    "logo_download_filename": {
      "type": [
        "string",
        "null"
      ],
      "description": "Veilige downloadbestandsnaam van het objectlogo"
    },
    "logo_logical_path": {
      "type": [
        "string",
        "null"
      ],
      "description": "Logisch ManagedFile-pad van het objectlogo"
    },
    "address": {
      "type": "string",
      "description": "Volledig adres van het object"
    },
    "street_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "house_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "house_number_addition": {
      "type": [
        "string",
        "null"
      ]
    },
    "postal_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "country_code": {
      "type": [
        "string",
        "null"
      ],
      "default": "NL"
    },
    "country_name": {
      "type": [
        "string",
        "null"
      ],
      "default": "Nederland"
    },
    "geocoding_status": {
      "type": "string",
      "enum": [
        "unverified",
        "verified",
        "manual"
      ],
      "default": "unverified"
    },
    "bag_address_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optionele BAG-identificatie van het gekozen adres"
    },
    "latitude": {
      "type": [
        "number",
        "null"
      ],
      "description": "Breedtegraad"
    },
    "longitude": {
      "type": [
        "number",
        "null"
      ],
      "description": "Lengtegraad"
    },
    "task_spacing_groups": {
      "type": "array",
      "description": "Gebruiksvriendelijke plannerregels om meerdere taaksoorten uit elkaar te houden",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "task_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min_minutes": {
            "type": "number"
          },
          "include_same_type": {
            "type": "boolean"
          }
        }
      }
    },
    "task_spacing_rules": {
      "type": "array",
      "description": "Technische serverregels met minimale afstand tussen taaktypes op hetzelfde object",
      "items": {
        "type": "object",
        "properties": {
          "task_type_a": {
            "type": "string"
          },
          "task_type_b": {
            "type": "string"
          },
          "min_minutes": {
            "type": "number"
          }
        }
      }
    },
    "parking_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "entry_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "walking_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "access_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "alarm_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "key_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "safety_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_incident_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_map_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_map_file_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "parking_point_latitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "parking_point_longitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "entry_point_latitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "entry_point_longitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "building_polygon_geojson": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Canonieke WGS84 FeatureCollection met BAG-pandcontouren en eventuele expliciet handmatig getekende gebouwcontouren"
    },
    "building_selection_points": {
      "type": "array",
      "maxItems": 100,
      "default": [],
      "description": "Door de gebruiker aangeklikte WGS84-posities voor 3D-gebouwen zonder BAG-koppeling. Bevat geen Mapbox-contouren of tijdelijke Mapbox-feature-ID's.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 120 },
          "source": { "type": "string", "enum": ["user_selected"] },
          "provider": { "type": "string", "enum": ["mapbox"] },
          "bag_status": { "type": "string", "enum": ["unlinked"] },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 }
        },
        "required": ["id", "source", "provider", "bag_status", "longitude", "latitude"]
      }
    },
    "object_area_geojson": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Canonieke WGS84 FeatureCollection met operationele terreinvlakken, eventueel begonnen vanuit een PDOK-perceel met gesaneerde herkomstverwijzing"
    },
    "building_selection_mode": {
      "type": "string",
      "enum": [
        "automatic",
        "manual"
      ],
      "default": "automatic",
      "description": "Automatic gebruikt de legacy nabijheidslogica; manual gebruikt uitsluitend de expliciet opgeslagen contouren en mag bewust leeg zijn"
    },
    "map_geometry_status": {
      "type": "string",
      "enum": [
        "unconfigured",
        "configured",
        "needs_review"
      ],
      "default": "unconfigured",
      "description": "Reviewstatus van de gebouw- en terreinconfiguratie; een relevante adreswijziging zet bestaande geometrie op needs_review"
    },
    "map_geometry_revision": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Monotoon oplopende revisie waarmee mobiele kaartcaches exact kunnen worden ververst"
    },
    "map_geometry_hash": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80,
      "description": "SHA-256 van de canonieke gebouwmodus en opgeslagen gebouw- en terreingeometrie"
    },
    "map_geometry_updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "map_geometry_updated_by_user_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Backofficegebruiker die de kaartconfiguratie het laatst heeft opgeslagen of reviewplichtig heeft gemaakt"
    },
    "map_geometry_review_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500,
      "description": "Technische, niet-gevoelige reden waarom de kaartconfiguratie opnieuw gecontroleerd moet worden"
    },
    "show_on_mobile_map": {
      "type": "boolean",
      "default": false
    },
    "is_active_customer_object": {
      "type": "boolean",
      "default": false
    },
    "mobile_map_priority": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Opmerkingen"
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "name",
    "address",
    "customer_id"
  ],
  "rls": {
    "create": false,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": false
  }
}
