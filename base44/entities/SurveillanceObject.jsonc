{
  "name": "SurveillanceObject",
  "type": "object",
  "properties": {
    "object_code": {
      "type": "string",
      "description": "Objectcode"
    },
    "customer_id": {
      "type": "string",
      "description": "ID van de gekoppelde klant"
    },
    "name": {
      "type": "string",
      "description": "Naam van het object/locatie"
    },
    "address": {
      "type": "string",
      "description": "Volledig adres van het object"
    },
    "latitude": {
      "type": "number",
      "description": "Breedtegraad"
    },
    "longitude": {
      "type": "number",
      "description": "Lengtegraad"
    },
    "task_spacing_groups": {
      "type": "array",
      "description": "Gebruiksvriendelijke plannerregels om meerdere taaksoorten uit elkaar te houden",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "task_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min_minutes": {
            "type": "number"
          },
          "include_same_type": {
            "type": "boolean"
          }
        }
      }
    },
    "task_spacing_rules": {
      "type": "array",
      "description": "Technische serverregels met minimale afstand tussen taaktypes op hetzelfde object",
      "items": {
        "type": "object",
        "properties": {
          "task_type_a": {
            "type": "string"
          },
          "task_type_b": {
            "type": "string"
          },
          "min_minutes": {
            "type": "number"
          }
        }
      }
    },
    "parking_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "entry_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "walking_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "access_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "alarm_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "key_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "safety_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_incident_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_map_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_map_file_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "parking_point_latitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "parking_point_longitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "entry_point_latitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "entry_point_longitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "building_polygon_geojson": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "object_area_geojson": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "show_on_mobile_map": {
      "type": "boolean",
      "default": true
    },
    "is_active_customer_object": {
      "type": "boolean",
      "default": true
    },
    "mobile_map_priority": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string",
      "description": "Opmerkingen"
    }
  },
  "required": [
    "name",
    "address",
    "customer_id"
  ]
}