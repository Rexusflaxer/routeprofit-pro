{
  "name": "SurveillanceObject",
  "type": "object",
  "properties": {
    "object_code": {
      "type": "string",
      "description": "Objectcode"
    },
    "customer_id": {
      "type": "string",
      "description": "ID van de gekoppelde klant"
    },
    "name": {
      "type": "string",
      "description": "Naam van het object/locatie"
    },
    "address": {
      "type": "string",
      "description": "Volledig adres van het object"
    },
    "latitude": {
      "type": "number",
      "description": "Breedtegraad"
    },
    "longitude": {
      "type": "number",
      "description": "Lengtegraad"
    },
    "task_spacing_groups": {
      "type": "array",
      "description": "Gebruiksvriendelijke plannerregels om meerdere taaksoorten uit elkaar te houden",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "task_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min_minutes": {
            "type": "number"
          },
          "include_same_type": {
            "type": "boolean"
          }
        }
      }
    },
    "task_spacing_rules": {
      "type": "array",
      "description": "Technische serverregels met minimale afstand tussen taaktypes op hetzelfde object",
      "items": {
        "type": "object",
        "properties": {
          "task_type_a": {
            "type": "string"
          },
          "task_type_b": {
            "type": "string"
          },
          "min_minutes": {
            "type": "number"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Opmerkingen"
    }
  },
  "required": [
    "name",
    "address",
    "customer_id"
  ]
}