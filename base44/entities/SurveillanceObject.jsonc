{
  "name": "SurveillanceObject",
  "type": "object",
  "properties": {
    "object_code": {
      "type": "string",
      "description": "Objectcode"
    },
    "customer_id": {
      "type": "string",
      "description": "ID van de gekoppelde klant"
    },
    "cao_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Default CAO-key voor diensten op dit object wanneer taak/planning geen specifiekere CAO-key meegeeft"
    },
    "default_service_function_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Default functietype voor diensten op dit object, bijvoorbeeld surveillant, receptioniste of klantrelatie"
    },
    "default_cao_function_group": {
      "type": [
        "string",
        "null"
      ],
      "description": "Default CAO-functiegroep voor diensten op dit object"
    },
    "default_cao_function_level": {
      "type": [
        "string",
        "null"
      ],
      "description": "Default CAO-functieniveau voor diensten op dit object"
    },
    "default_security_role_status": {
      "type": [
        "string",
        "null"
      ],
      "description": "Default beveiligingsstatus voor diensten op dit object, bijvoorbeeld aspirant_beveiliger of beveiliger"
    },
    "default_required_qualification_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Default kwalificatie-/diplomatypes voor diensten op dit object."
    },
    "default_required_qualification_groups": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Default kwalificatiegroepen voor diensten op dit object, bijvoorbeeld base_security, advanced_security, ehbo_or_bhv of centralist_basic."
    },
    "default_performs_security_work": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Default of diensten op dit object feitelijk beveiligingswerk zijn"
    },
    "default_security_work_percentage": {
      "type": [
        "number",
        "null"
      ],
      "description": "Default percentage beveiligingswerk voor diensten op dit object"
    },
    "default_works_event_or_hospitality_security": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Default of diensten op dit object evenementen- of horecabeveiliging betreffen"
    },
    "default_event_hospitality_cao_applies": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Default of voor diensten op dit object de evenementen-/horecabeveiligings-CAO geldt"
    },
    "default_works_airport_schiphol": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Default of diensten op dit object onder Schiphol/airport-context vallen"
    },
    "default_works_cash_value_logistics": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Default of diensten op dit object geld- en waardelogistiek betreffen"
    },
    "default_customer_billable": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Default of diensten op dit object klantfacturabel zijn"
    },
    "default_counts_toward_required_staffing": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Default of diensten op dit object meetellen voor verplichte bezetting"
    },
    "contract_assignment_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "strict_contract_match",
        "allow_manual_review",
        null
      ],
      "description": "Default contractmatchingbeleid voor diensten op dit object"
    },
    "default_operating_company_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Default werkgever/bedrijf dat diensten op dit object uitvoert wanneer taak/route geen specifieker bedrijf meegeeft."
    },
    "name": {
      "type": "string",
      "description": "Naam van het object/locatie"
    },
    "address": {
      "type": "string",
      "description": "Volledig adres van het object"
    },
    "latitude": {
      "type": "number",
      "description": "Breedtegraad"
    },
    "longitude": {
      "type": "number",
      "description": "Lengtegraad"
    },
    "task_spacing_groups": {
      "type": "array",
      "description": "Gebruiksvriendelijke plannerregels om meerdere taaksoorten uit elkaar te houden",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "task_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min_minutes": {
            "type": "number"
          },
          "include_same_type": {
            "type": "boolean"
          }
        }
      }
    },
    "task_spacing_rules": {
      "type": "array",
      "description": "Technische serverregels met minimale afstand tussen taaktypes op hetzelfde object",
      "items": {
        "type": "object",
        "properties": {
          "task_type_a": {
            "type": "string"
          },
          "task_type_b": {
            "type": "string"
          },
          "min_minutes": {
            "type": "number"
          }
        }
      }
    },
    "parking_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "entry_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "walking_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "access_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "alarm_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "key_instruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "safety_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_incident_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_map_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_map_file_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "parking_point_latitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "parking_point_longitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "entry_point_latitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "entry_point_longitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "building_polygon_geojson": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "object_area_geojson": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "show_on_mobile_map": {
      "type": "boolean",
      "default": true
    },
    "is_active_customer_object": {
      "type": "boolean",
      "default": true
    },
    "mobile_map_priority": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string",
      "description": "Opmerkingen"
    }
  },
  "required": [
    "name",
    "address",
    "customer_id"
  ]
}
