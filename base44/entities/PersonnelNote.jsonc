{
  "name": "PersonnelNote",
  "type": "object",
  "properties": {
    "personnel_id": {
      "type": "string"
    },
    "note_type": {
      "type": "string",
      "enum": [
        "general",
        "planning",
        "compliance",
        "hr",
        "teamhub",
        "other"
      ],
      "default": "general"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "body": {
      "type": "string"
    },
    "is_private": {
      "type": "boolean",
      "default": true
    },
    "created_by_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "personnel_id",
    "body",
    "created_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
