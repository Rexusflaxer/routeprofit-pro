{
  "name": "PlanningShift",
  "type": "object",
  "properties": {
    "source_key": {
      "type": "string",
      "description": "Logisch unieke, stabiele herkomstsleutel. Route-bootstrap gebruikt route:<route_id>:<service_date>."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "route",
        "task",
        "service",
        "copy",
        "manual"
      ]
    },
    "source_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_shift_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Oorspronkelijke PlanningShift bij een kopie."
    },
    "source_route_execution_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "company_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Uitvoerend bedrijf/werkgever voor contract- en CAO-routering."
    },
    "customer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "customer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Alle klanten binnen een samengestelde route; customer_id is alleen gevuld bij exact één klant."
    },
    "object_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Alle objecten binnen een samengestelde route; object_id is alleen gevuld bij exact één object."
    },
    "route_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "customer_contract_line_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "customer_name_snapshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_name_snapshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "route_name_snapshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "service_name_snapshot": {
      "type": "string"
    },
    "service_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Expliciete einddatum voor meerdaagse/nachtdiensten; leeg betekent dezelfde dag of automatisch de volgende dag wanneer eindtijd niet na starttijd ligt."
    },
    "start_time": {
      "type": "string",
      "description": "Lokale tijd in HH:MM, geïnterpreteerd in timezone."
    },
    "end_time": {
      "type": "string",
      "description": "Lokale tijd in HH:MM, geïnterpreteerd in timezone."
    },
    "timezone": {
      "type": "string",
      "default": "Europe/Amsterdam"
    },
    "duration_minutes": {
      "type": [
        "number",
        "null"
      ]
    },
    "required_count": {
      "type": "number",
      "default": 1,
      "description": "Aantal afzonderlijke bezettingsplaatsen; slot_index loopt van 0 tot required_count - 1."
    },
    "cao_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "service_function_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_cao_function_group": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_cao_function_level": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_security_role_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "aspirant_beveiliger",
        "beveiliger",
        "leidinggevende",
        "not_applicable",
        "unknown",
        null
      ]
    },
    "required_qualification_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "required_qualification_groups": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "contract_assignment_policy": {
      "type": "string",
      "enum": [
        "strict_contract_match",
        "allow_manual_review"
      ],
      "default": "allow_manual_review"
    },
    "performs_security_work": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "security_work_percentage": {
      "type": [
        "number",
        "null"
      ]
    },
    "works_event_or_hospitality_security": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "event_hospitality_cao_applies": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "works_airport_schiphol": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "works_cash_value_logistics": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "customer_billable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "counts_toward_required_staffing": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "service_context_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "cancelled"
      ],
      "default": "draft"
    },
    "revision": {
      "type": "number",
      "default": 1,
      "description": "Optimistic-concurrency-versie van het werkrecord."
    },
    "published_revision": {
      "type": "number",
      "default": 0,
      "description": "Laatste recordrevision die in een onveranderlijke PlanningPublication is opgenomen."
    },
    "last_published_correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_modified_by_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_modified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "source_key",
    "source_type",
    "service_name_snapshot",
    "service_date",
    "start_time",
    "end_time",
    "required_count",
    "status",
    "revision",
    "published_revision"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
