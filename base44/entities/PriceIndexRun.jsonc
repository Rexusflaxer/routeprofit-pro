{
  "name": "PriceIndexRun",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "price_index_profile_id": {
      "type": "string"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "percentage_basis_points": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "applied",
        "failed",
        "cancelled"
      ],
      "default": "draft"
    },
    "source_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "affected_rate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "created_rate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "result_summary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "approved_by_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "applied_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "company_id",
    "price_index_profile_id",
    "effective_date",
    "percentage_basis_points",
    "status",
    "idempotency_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
