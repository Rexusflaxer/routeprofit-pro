{
  "name": "CompanyBankAccount",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID van het bedrijf"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "normal",
        "g_account"
      ],
      "default": "normal"
    },
    "iban": {
      "type": "string",
      "description": "Gemaskerde IBAN bij nieuwe records. Volledige IBAN staat versleuteld in iban_encrypted_payload."
    },
    "iban_masked": {
      "type": [
        "string",
        "null"
      ]
    },
    "iban_encrypted_payload": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "sensitive_payload_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "account_holder_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "bank_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "bic": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "is_default_for_invoicing": {
      "type": "boolean",
      "default": false
    },
    "is_default_for_payroll": {
      "type": "boolean",
      "default": false
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "proof_file_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "proof_file_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "ManagedFile ID voor het bankbewijs"
    },
    "proof_download_filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "proof_logical_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "pending",
        "archived"
      ],
      "default": "active"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "company_id",
    "iban"
  ]
}
