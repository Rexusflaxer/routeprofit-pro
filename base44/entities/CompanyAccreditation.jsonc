{
  "name": "CompanyAccreditation",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID van het bedrijf"
    },
    "category": {
      "type": "string",
      "enum": [
        "technical_certification",
        "quality_mark",
        "other"
      ],
      "default": "technical_certification"
    },
    "accreditation_type": {
      "type": "string",
      "enum": [
        "borg_e",
        "borg_b",
        "veb_4",
        "ccv_bmi_leveren",
        "ccv_bmi_onderhoud",
        "ccv_bmi_oai_installeren",
        "ccv_oai",
        "iso_9001",
        "iso_27001",
        "vca",
        "veb_pbo_kwaliteitsregeling",
        "nvb_keurmerk_beveiliging",
        "nvb_keurmerk_evenementenbeveiliging",
        "nvb_keurmerk_horecabeveiliging",
        "nvb_keurmerk_gwt",
        "nvb_keurmerk_pob",
        "vvnl_kwaliteitslabel_regulier",
        "vvnl_kwaliteitslabel_ehb",
        "vvnl_kwaliteitslabel_verkeersregelaars",
        "bpob_keurmerk_particulier_onderzoeksbureau",
        "nvb_bhv_opleidingsinstituut",
        "other_technical",
        "other"
      ]
    },
    "name": {
      "type": "string",
      "description": "Naam van de erkenning of certificering"
    },
    "issuer": {
      "type": [
        "string",
        "null"
      ]
    },
    "certificate_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending_review",
        "suspended",
        "expired"
      ],
      "default": "active"
    },
    "document_file_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_file_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_download_filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_logical_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "company_id",
    "accreditation_type",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
