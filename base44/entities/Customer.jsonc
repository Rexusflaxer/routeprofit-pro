{
  "name": "Customer",
  "type": "object",
  "properties": {
    "customer_type": {
      "type": "string",
      "enum": [
        "particulier",
        "bedrijf"
      ],
      "description": "Legacy klanttype; behouden voor bestaande callers.",
      "default": "bedrijf"
    },
    "name": {
      "type": "string",
      "description": "Legacy weergavenaam; blijft gespiegeld aan trade_name of legal_name."
    },
    "contact_person": {
      "type": [
        "string",
        "null"
      ],
      "description": "Legacy primaire contactnaam; blijft gespiegeld aan CustomerContact."
    },
    "email": {
      "type": [
        "string",
        "null"
      ],
      "description": "Legacy primair e-mailadres; blijft gespiegeld aan CustomerContactPoint."
    },
    "phone": {
      "type": [
        "string",
        "null"
      ],
      "description": "Legacy primair telefoonnummer; blijft gespiegeld aan CustomerContactPoint."
    },
    "address": {
      "type": [
        "string",
        "null"
      ],
      "description": "Legacy bezoekadres; blijft gespiegeld aan CustomerAddress."
    },
    "kvk_number": {
      "type": [
        "string",
        "null"
      ],
      "description": "KvK-nummer."
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Legacy algemene notitie. Nieuwe gebeurtenissen en notities horen in CustomerEvent."
    },
    "customer_number": {
      "type": [
        "string",
        "null"
      ],
      "description": "Stabiel, menselijk klantnummer."
    },
    "legal_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Statutaire naam van de juridische partij."
    },
    "trade_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Handelsnaam."
    },
    "normalized_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Genormaliseerde naam voor duplicaatcontrole en zoeken."
    },
    "vat_number": {
      "type": [
        "string",
        "null"
      ],
      "description": "Btw-identificatienummer."
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "nl",
        "en",
        "de",
        "fr",
        "other"
      ],
      "default": "nl"
    },
    "status": {
      "type": "string",
      "enum": [
        "concept",
        "active",
        "on_hold",
        "inactive",
        "archived"
      ],
      "default": "concept"
    },
    "primary_contact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "primary_customer_account_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "logo_file_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "onboarding_state": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Afgeleide checkliststatus; geen autorisatiebron."
    },
    "object_creation_reservation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Kortdurende, atomair via de klantversie geclaimde reservering die dubbele gelijktijdige objectaanmaak voorkomt."
    },
    "creation_idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Duurzame sleutel om het aanmaken en hervatten van een klantdossier idempotent te maken."
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Optimistic concurrency-versie."
    },
    "archived_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "archived_by_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "archive_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "name",
    "customer_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
