{
  "name": "Task",
  "type": "object",
  "properties": {
    "object_id": {
      "type": "string",
      "description": "ID van het gekoppelde object (leeg bij collectief-taak)"
    },
    "collectief_id": {
      "type": "string",
      "description": "ID van het gekoppelde collectief (alleen bij collectief-taak)"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "Mobiele Controleronde",
        "Externe Controleronde",
        "Externe Sluitronde",
        "Brand- en Sluitronde",
        "Openingsronde",
        "Sluitbegeleiding"
      ],
      "description": "Type taak"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Totale taakduur in minuten (bij collectief: totaal voor alle items)"
    },
    "time_window_start": {
      "type": "string",
      "description": "Vroegste aanvangstijd (HH:MM)"
    },
    "time_window_end": {
      "type": "string",
      "description": "Uiterste eindtijd (HH:MM)"
    },
    "use_arrival_deadline": {
      "type": "boolean",
      "description": "Gebruik een minimale aankomsttijd/deadline in plaats van een volledig tijdvenster",
      "default": false
    },
    "arrival_deadline_time": {
      "type": "string",
      "description": "Uiterste aankomsttijd voor taken zoals Sluitbegeleiding of optionele Openingsronde (HH:MM)"
    },
    "latest_departure_time": {
      "type": "string",
      "description": "Laatste vertrektijd voor taken met een minimale aankomsttijd (HH:MM)"
    },
    "extra_time_windows": {
      "type": "array",
      "description": "Extra tijdvensters waarbinnen de taak (deels) uitgevoerd mag worden",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        }
      }
    },
    "allow_split": {
      "type": "boolean",
      "description": "Taak mag in meerdere delen worden uitgevoerd binnen het tijdvenster",
      "default": false
    },
    "weekdays": {
      "type": "array",
      "description": "Dagen van de week: 1=Maandag, 7=Zondag",
      "items": {
        "type": "number"
      }
    },
    "pricing_type": {
      "type": "string",
      "enum": [
        "per_taak",
        "per_minuut"
      ],
      "description": "Prijsberekening per taak of per minuut",
      "default": "per_taak"
    },
    "price_amount": {
      "type": "number",
      "description": "Prijs in euro (per taak of per minuut afhankelijk van pricing_type)"
    },
    "is_free": {
      "type": "boolean",
      "description": "Gratis service \u2014 niet in rekening brengen bij klant",
      "default": false
    },
    "selected_object_ids": {
      "type": "array",
      "description": "Geselecteerde object-IDs voor deze collectief-taak",
      "items": {
        "type": "string"
      }
    },
    "selected_sub_collectief_ids": {
      "type": "array",
      "description": "Geselecteerde sub-collectief-IDs voor deze collectief-taak",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "task_type",
    "duration_minutes"
  ]
}