{
  "name": "Task",
  "type": "object",
  "properties": {
    "object_id": {
      "type": "string",
      "description": "ID van het gekoppelde object (leeg bij collectief-taak)"
    },
    "collectief_id": {
      "type": "string",
      "description": "ID van het gekoppelde collectief (alleen bij collectief-taak)"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "Mobiele Controleronde",
        "Externe Controleronde",
        "Externe Sluitronde",
        "Brand- en Sluitronde",
        "Openingsronde",
        "Sluitbegeleiding",
        "Grote collectief"
      ],
      "description": "Type taak"
    },
    "service_function_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Functiesoort die nodig is voor deze dienst, bijv. surveillant, centralist, objectbeveiliger, receptie, binnendienst."
    },
    "required_cao_function_group": {
      "type": [
        "string",
        "null"
      ],
      "description": "CAO-functiegroep die nodig is voor deze dienst, bijv. objectbeveiliger_receptionist."
    },
    "required_cao_function_level": {
      "type": [
        "string",
        "null"
      ],
      "description": "Minimaal/vereist CAO-functieniveau voor deze dienst als dit vooraf bekend is."
    },
    "required_security_role_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "aspirant_beveiliger",
        "beveiliger",
        "leidinggevende",
        "not_applicable",
        "unknown",
        null
      ],
      "description": "Benodigde beveiligingsstatus voor deze dienst."
    },
    "required_qualification_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Expliciete kwalificatie-/diplomatypes die voor deze dienst vereist zijn, naast automatisch afgeleide CAO PB bijlage-2/bijlage-3 eisen."
    },
    "required_qualification_groups": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Expliciete kwalificatiegroepen voor deze dienst, bijvoorbeeld base_security, advanced_security, ehbo_or_bhv, brandwacht_base of centralist_basic."
    },
    "contract_assignment_policy": {
      "type": "string",
      "enum": [
        "strict_contract_match",
        "allow_manual_review"
      ],
      "default": "strict_contract_match",
      "description": "Bepaalt hoe streng de planning deze taak aan een arbeidscontract moet koppelen."
    },
    "operating_company_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Werkgever/bedrijf dat deze dienst uitvoert. Nodig om bij meerdere werkgevers het juiste arbeidscontract en de juiste CAO te kiezen."
    },
    "cao_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "CAO sleutel die deze dienst vraagt, bijv. cao_particuliere_beveiliging. Leeg betekent afleiden uit route/bedrijf/contract."
    },
    "performs_security_work": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "True als deze dienst beveiligingswerk vraagt; false voor niet-beveiligingswerk zoals pure klantrelatie/binnendienst."
    },
    "security_work_percentage": {
      "type": [
        "number",
        "null"
      ],
      "description": "Percentage beveiligingswerk binnen deze dienst. Nodig voor art. 3 lid 2 en mixed-scope review."
    },
    "works_event_or_hospitality_security": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "True als deze dienst evenementen-/horecabeveiliging betreft."
    },
    "event_hospitality_cao_applies": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "True als voor deze dienst de evenementen-/horecabeveiligings-CAO geldt in plaats van CAO PB."
    },
    "works_airport_schiphol": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "True als deze dienst onder Schiphol-specifieke CAO PB regels kan vallen."
    },
    "works_cash_value_logistics": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "True als deze dienst geld- en waardelogistiek betreft."
    },
    "customer_billable": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "True als deze dienst aan de klant wordt gefactureerd; relevant voor stage-/inhuurregels en audit."
    },
    "counts_toward_required_staffing": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "True als deze dienst meetelt voor vereiste bezetting; relevant voor stage- en dienstcontextregels."
    },
    "internship_practice_trainer_personnel_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Praktijkopleider die aan deze stagedienst is gekoppeld. Nodig voor CAO PB artikel 14 toetsing."
    },
    "internship_mentor_personnel_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Mentor/begeleider voor deze stagedienst wanneer afwijkend van de praktijkopleider."
    },
    "internship_one_to_one_guidance_confirmed": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Bevestigt dat per dag evenveel stagiairs als praktijkopleiders worden ingezet voor deze dienst."
    },
    "internship_uniform_label_confirmed": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Bevestigt dat de stagiair bij deze dienst herkenbaar als stagiair op het uniform staat."
    },
    "duration_minutes": {
      "type": "number",
      "description": "Totale taakduur in minuten (bij collectief: totaal voor alle items)"
    },
    "time_window_start": {
      "type": "string",
      "description": "Vroegste aanvangstijd (HH:MM)"
    },
    "time_window_end": {
      "type": "string",
      "description": "Uiterste eindtijd (HH:MM)"
    },
    "repeat_count": {
      "type": "number",
      "description": "Aantal keer dat deze taak binnen het tijdvenster uitgevoerd moet worden",
      "default": 1
    },
    "min_minutes_between_visits": {
      "type": "number",
      "description": "Minimaal aantal minuten tussen herhaalde uitvoeringen van dezelfde taak",
      "default": 0
    },
    "use_custom_execution_blocks": {
      "type": "boolean",
      "description": "Gebruik aangepaste uitvoeringsblokken per herhaling",
      "default": false
    },
    "custom_execution_blocks": {
      "type": "array",
      "description": "Aangepaste tijdblokken per uitvoering",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "time_window_start": {
            "type": "string"
          },
          "time_window_end": {
            "type": "string"
          }
        }
      }
    },
    "task_spacing_rules": {
      "type": "array",
      "description": "Optionele taak-specifieke minimale afstand tussen taaktypes",
      "items": {
        "type": "object",
        "properties": {
          "task_type_a": {
            "type": "string"
          },
          "task_type_b": {
            "type": "string"
          },
          "min_minutes": {
            "type": "number"
          }
        }
      }
    },
    "min_minutes_between_other_tasks": {
      "type": "number",
      "description": "Minimale buffer in minuten tussen deze taak en andere taken",
      "default": 0
    },
    "use_arrival_deadline": {
      "type": "boolean",
      "description": "Gebruik een minimale aankomsttijd/deadline in plaats van een volledig tijdvenster",
      "default": false
    },
    "arrival_deadline_time": {
      "type": "string",
      "description": "Uiterste aankomsttijd voor taken zoals Sluitbegeleiding of optionele Openingsronde (HH:MM)"
    },
    "latest_departure_time": {
      "type": "string",
      "description": "Laatste vertrektijd voor taken met een minimale aankomsttijd (HH:MM)"
    },
    "extra_time_windows": {
      "type": "array",
      "description": "Extra tijdvensters waarbinnen de taak (deels) uitgevoerd mag worden",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        }
      }
    },
    "allow_split": {
      "type": "boolean",
      "description": "Taak mag in meerdere delen worden uitgevoerd binnen het tijdvenster",
      "default": false
    },
    "split_part_count": {
      "type": "number",
      "description": "Aantal delen waarin een splitsbare taak mag worden ingepland",
      "default": 1
    },
    "weekdays": {
      "type": "array",
      "description": "Dagen van de week: 1=Maandag, 7=Zondag",
      "items": {
        "type": "number"
      }
    },
    "pricing_type": {
      "type": "string",
      "enum": [
        "per_taak",
        "per_minuut"
      ],
      "description": "Prijsberekening per taak of per minuut",
      "default": "per_taak"
    },
    "price_amount": {
      "type": "number",
      "description": "Prijs in euro (per taak of per minuut afhankelijk van pricing_type)"
    },
    "is_free": {
      "type": "boolean",
      "description": "Gratis service \u2014 niet in rekening brengen bij klant",
      "default": false
    },
    "selected_object_ids": {
      "type": "array",
      "description": "Geselecteerde object-IDs voor deze collectief-taak",
      "items": {
        "type": "string"
      }
    },
    "selected_sub_collectief_ids": {
      "type": "array",
      "description": "Geselecteerde sub-collectief-IDs voor deze collectief-taak",
      "items": {
        "type": "string"
      }
    },
    "planning_contract_context": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Snapshot/context voor toekomstige planner: benodigde functie, CAO-scope en contractmatch-regels."
    },
    "planning_context_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "planning_context_ready",
        "missing_context",
        "manual_review_required",
        "blocked",
        "unknown",
        null
      ],
      "default": "unknown",
      "description": "Auditstatus van de dienstcontext voordat een medewerker wordt ingepland. Niet ready betekent geen definitieve planning/payroll zonder review."
    },
    "planning_context_missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Ontbrekende dienstcontextvelden, bijv. operating_company_id, cao_key_or_company_assignment, service_function_type, required_cao_function_group of performs_security_work."
    },
    "planning_context_manual_review_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Redenen waarom deze taak/dienstcontext handmatige CAO- of contractreview vereist."
    },
    "planning_context_blocking_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Blokkerende redenen waarom deze taak niet definitief gepland/payroll-final gebruikt mag worden."
    },
    "planning_context_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Niet-blokkerende waarschuwingen over CAO-/contractcontext van deze taak."
    },
    "planning_context_checked_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO datetime waarop de dienstcontext-readiness voor het laatst is vastgesteld."
    },
    "planning_context_source_rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "CAO-rule ids waarop de dienstcontextbeoordeling is gebaseerd."
    }
  },
  "required": [
    "task_type",
    "duration_minutes"
  ]
}
