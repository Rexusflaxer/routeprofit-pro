{
  "name": "ObjectSecurityPlan",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "object_security",
        "fire_closing_round",
        "external_closing_round",
        "external_control_round",
        "opening_round",
        "mobile_control_round",
        "reception"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "scope_type": {
      "type": "string",
      "enum": [
        "full",
        "partial",
        "not_applicable"
      ],
      "default": "not_applicable"
    },
    "duration_minutes": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 1
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "customer_id",
    "object_id",
    "category",
    "title",
    "scope_type",
    "status"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
