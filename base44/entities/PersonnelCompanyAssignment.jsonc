{
  "name": "PersonnelCompanyAssignment",
  "type": "object",
  "properties": {
    "personnel_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "cao_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Legacy/reference CAO sleutel voor deze medewerker-bedrijfskoppeling. Niet gebruiken als fallback voor arbeidscontracten: PersonnelContract.cao_key is verplicht voor planning/payroll."
    },
    "assignment_status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "ended"
      ],
      "default": "active"
    },
    "is_primary": {
      "type": "boolean",
      "default": false
    },
    "available_for_planning": {
      "type": "boolean",
      "default": true
    },
    "relation_type": {
      "type": "string",
      "enum": [
        "employee",
        "contractor",
        "intern",
        "temporary",
        "other"
      ],
      "default": "employee"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "default_cao_configuration_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Legacy/reference configuratie. Niet gebruiken om een ontbrekende contract-CAO aan te vullen; contracten moeten zelf cao_key bevatten."
    },
    "source_contract_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Actieve en toekomstige contracten waaruit deze medewerker-bedrijfskoppeling is afgeleid."
    },
    "managed_by_contracts": {
      "type": "boolean",
      "default": false,
      "description": "True als status en geldigheid automatisch uit arbeidscontracten worden onderhouden."
    },
    "contract_sync_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "future_contract_placeholder": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "personnel_id",
    "company_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
