{
  "name": "PersonnelBankAccount",
  "type": "object",
  "properties": {
    "personnel_id": {
      "type": "string"
    },
    "iban": {
      "type": "string",
      "description": "Gemaskerde IBAN bij nieuwe records. Volledige IBAN staat versleuteld in iban_encrypted_payload."
    },
    "iban_masked": {
      "type": [
        "string",
        "null"
      ]
    },
    "iban_encrypted_payload": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "sensitive_payload_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "account_holder_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "bank_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "proof_document_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "proof_file_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "ManagedFile ID voor het bankbewijs"
    },
    "proof_file_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "proof_download_filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "proof_logical_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "proof_front_file_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "proof_front_file_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "proof_front_download_filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "proof_front_logical_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "proof_back_file_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "proof_back_file_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "proof_back_download_filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "proof_back_logical_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_primary": {
      "type": "boolean",
      "default": false
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "verified",
        "rejected",
        "expired"
      ],
      "default": "pending_review"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Audit metadata en archiveringsstatus"
    }
  },
  "required": [
    "personnel_id",
    "iban"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
