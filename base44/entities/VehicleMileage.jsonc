{
  "name": "VehicleMileage",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string",
      "description": "ID van het voertuig"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Datum van km-stand"
    },
    "mileage": {
      "type": "number",
      "description": "KM-stand"
    },
    "notes": {
      "type": "string",
      "description": "Opmerkingen"
    }
  },
  "required": [
    "vehicle_id",
    "date",
    "mileage"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
