{
  "name": "ObjectRelationship",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "relation_type": {
      "type": "string",
      "enum": [
        "pac",
        "video_monitoring_center",
        "security_installer",
        "fire_safety_installer",
        "camera_installer",
        "access_control_installer",
        "maintenance_provider",
        "key_management",
        "guarding_company",
        "other"
      ]
    },
    "custom_relation_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "reference_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "phone": {
      "type": [
        "string",
        "null"
      ]
    },
    "email": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "archived_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "archived_by_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "creation_idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "creation_request_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "creation_actor_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "creation_mutation_target": {
      "type": [
        "string",
        "null"
      ]
    },
    "customer_platform_last_mutation_key_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "customer_platform_last_mutation_recovery": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "customer_platform_mutation_key_hashes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "customer_platform_mutation_recoveries": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "customer_id",
    "object_id",
    "organization_id",
    "relation_type",
    "status"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
