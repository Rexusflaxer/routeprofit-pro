{
  "name": "Collectief",
  "type": "object",
  "properties": {
    "object_code": {
      "type": "string",
      "description": "Objectcode van het bedrijfsverzamelgebouw"
    },
    "name": {
      "type": "string",
      "description": "Naam van het collectief"
    },
    "collectief_type": {
      "type": "string",
      "enum": [
        "regio_groep",
        "bedrijventerrein",
        "bedrijfsverzamelgebouw"
      ],
      "description": "Type collectief",
      "default": "bedrijventerrein"
    },
    "customer_id": {
      "type": "string",
      "description": "ID van de beherende klant"
    },
    "parent_collectief_id": {
      "type": "string",
      "description": "ID van het bovenliggende collectief (optioneel, voor nesting)"
    },
    "object_ids": {
      "type": "array",
      "description": "IDs van objecten die tot dit collectief behoren",
      "items": {
        "type": "string"
      }
    },
    "address": {
      "type": "string",
      "description": "Adres of locatie van het collectief"
    },
    "notes": {
      "type": "string",
      "description": "Opmerkingen"
    },
    "version": {
      "type": "number",
      "description": "Versienummer voor conflictveilige wijzigingen",
      "default": 1
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Unieke sleutel voor herstelbare server-side aanmaak; niet rechtstreeks vanuit de browser wijzigen."
    },
    "creation_request_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "description": "Server-side vingerafdruk waarmee hergebruik van een aanmaaksleutel met andere inhoud wordt geweigerd."
    }
  },
  "required": [
    "name",
    "collectief_type",
    "customer_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
