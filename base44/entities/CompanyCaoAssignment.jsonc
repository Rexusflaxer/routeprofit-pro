{
  "name": "CompanyCaoAssignment",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID van het bedrijf"
    },
    "cao_configuration_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optionele technische CAO-configuratie."
    },
    "cao_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Expliciete CAO sleutel voor deze bedrijfs-CAO-koppeling."
    },
    "is_primary": {
      "type": "boolean",
      "default": false
    },
    "applies_to_activities": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "Functie-/diensttokens waarvoor deze CAO bij dit bedrijf gebruikt mag worden."
    },
    "custom_function_defs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "archived": {
            "type": "boolean"
          }
        }
      },
      "description": "Handmatig toegevoegde functies per CAO-koppeling, inclusief label, categorie en archief-status."
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "company_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
