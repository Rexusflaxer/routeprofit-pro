{
  "name": "CompanyCaoAssignment",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID van het bedrijf"
    },
    "cao_configuration_id": {
      "type": "string",
      "description": "ID van de CAO-configuratie"
    },
    "cao_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Expliciete CAO sleutel voor deze bedrijfs-CAO-koppeling, bijv. cao_particuliere_beveiliging, cao_evenementen_horecabeveiliging, cao_verkeersregelaars of cao_veiligheidsdomein. Moet overeenkomen met de gekoppelde CAOConfiguration."
    },
    "is_primary": {
      "type": "boolean",
      "default": false
    },
    "applies_to_activities": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "Activiteiten/diensttokens waarop deze CAO-koppeling geldt. Voorbeelden: all, surveillant, objectbeveiliger_receptionist, event_hospitality_security, cao_evenementen_horecabeveiliging, verkeersregelaar, cao_verkeersregelaars, cash_value_logistics."
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "company_id",
    "cao_configuration_id"
  ]
}
