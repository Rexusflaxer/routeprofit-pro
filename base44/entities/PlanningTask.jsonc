{
  "name": "PlanningTask",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Naam van de taak"
    },
    "object_id": {
      "type": "string",
      "description": "Gekoppeld object ID"
    },
    "collectief_id": {
      "type": "string",
      "description": "Gekoppeld collectief ID"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "Mobiele Controleronde",
        "Externe Controleronde",
        "Externe Sluitronde",
        "Brand- en Sluitronde",
        "Openingsronde",
        "Service"
      ],
      "description": "Type taak"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Taakduur in minuten"
    },
    "time_windows": {
      "type": "array",
      "description": "Tijdvensters (meerdere mogelijk)",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        }
      }
    },
    "weekdays": {
      "type": "array",
      "description": "Beschikbare weekdagen: 1=Ma, 7=Zo",
      "items": {
        "type": "number"
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "contractueel_verplicht",
        "belangrijk",
        "optioneel"
      ],
      "default": "contractueel_verplicht",
      "description": "Verplichtingsniveau"
    },
    "penalty_if_unplanned": {
      "type": "number",
      "description": "Boete als taak niet gepland wordt",
      "default": 1000
    },
    "revenue_per_minute": {
      "type": "number",
      "description": "Opbrengst per minuut"
    },
    "required_vehicle_ids": {
      "type": "array",
      "description": "Voertuigen die deze taak mogen rijden (leeg = alle)",
      "items": {
        "type": "string"
      }
    },
    "selected_object_ids": {
      "type": "array",
      "description": "Voor collectief-taken: geselecteerde objecten",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "client_instructions": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "task_type",
    "duration_minutes"
  ]
}