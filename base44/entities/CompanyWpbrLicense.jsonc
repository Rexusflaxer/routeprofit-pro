{
  "name": "CompanyWpbrLicense",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID van het bedrijf"
    },
    "license_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ND",
        "HND",
        "BD",
        "PAC",
        "VTC",
        "PGW",
        "POB",
        "other",
        null
      ],
      "description": "WPBR-vergunningstype"
    },
    "license_number": {
      "type": [
        "string",
        "null"
      ],
      "description": "Vergunningsnummer"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Geldig vanaf"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Geldig tot"
    },
    "document_file_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "Ge\u00fcploade vergunning (PDF/afbeelding)"
    },
    "document_filename": {
      "type": [
        "string",
        "null"
      ],
      "description": "Bestandsnaam van het ge\u00fcploade document"
    },
    "document_file_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "ManagedFile ID van het vergunningsdocument"
    },
    "document_download_filename": {
      "type": [
        "string",
        "null"
      ],
      "description": "Commercieel nette downloadnaam"
    },
    "document_logical_path": {
      "type": [
        "string",
        "null"
      ],
      "description": "Logisch containerpad voor backup/export"
    },
    "document_metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "superseded"
      ],
      "default": "active",
      "description": "Status van de vergunning"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Opmerkingen"
    }
  },
  "required": [
    "company_id"
  ]
}
