{
  "name": "ObjectInstallation",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "installation_type": {
      "type": "string",
      "enum": [
        "alarm_system",
        "fire_alarm_system",
        "camera_system",
        "access_control",
        "intercom",
        "evacuation_alarm",
        "other"
      ]
    },
    "custom_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "brand": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "maintenance"
      ],
      "default": "active"
    }
  },
  "required": [
    "customer_id",
    "object_id",
    "installation_type",
    "name",
    "status"
  ]
}