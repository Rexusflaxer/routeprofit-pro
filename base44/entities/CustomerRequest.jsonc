{
  "name": "CustomerRequest",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_account_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "contact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "portal_membership_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_type": {
      "type": "string",
      "enum": [
        "schedule_change",
        "new_service",
        "object_change",
        "contact_change",
        "document_request",
        "complaint",
        "billing_question",
        "other"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "in_review",
        "accepted",
        "rejected",
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "draft"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "requested_for": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "desired_start_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "desired_end_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "decision_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "planned_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "backoffice",
        "customer_portal",
        "email",
        "phone",
        "import",
        "other"
      ],
      "default": "backoffice"
    },
    "submitted_by_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_by_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "submitted_by_contact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "submitted_by": {
      "type": [
        "string",
        "null"
      ],
      "description": "Legacy vrije actorweergave; submitted_by_user_id/contact_id zijn canoniek."
    },
    "submitted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reviewed_by_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Dedupe-sleutel voor portaal- en backofficemutaties."
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "company_id",
    "customer_id",
    "request_type",
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
