{
  "name": "ObjectHandbookCategory",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "parent_category_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "version": {
      "type": "number",
      "minimum": 1,
      "default": 1
    }
  },
  "required": [
    "customer_id",
    "object_id",
    "name",
    "status"
  ]
}