{
  "name": "Company",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "description": "Weergavenaam"
    },
    "legal_name": {
      "type": "string",
      "description": "Juridische naam"
    },
    "trade_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Handelsnaam"
    },
    "kvk_number": {
      "type": [
        "string",
        "null"
      ],
      "description": "KvK-nummer"
    },
    "rsin": {
      "type": [
        "string",
        "null"
      ],
      "description": "RSIN-nummer"
    },
    "btw_number": {
      "type": [
        "string",
        "null"
      ],
      "description": "BTW-nummer"
    },
    "legal_form": {
      "type": [
        "string",
        "null"
      ],
      "description": "Rechtsvorm, bijv. BV, VOF, ZZP"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "archived"
      ],
      "default": "active"
    },
    "archived_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Moment waarop het bedrijf naar het archief is verplaatst. Dit is het startpunt voor definitieve verwijdercontrole."
    },
    "company_role": {
      "type": "string",
      "enum": [
        "holding",
        "operating_company",
        "sole_proprietor",
        "other"
      ],
      "default": "operating_company"
    },
    "holding_company_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "ID van holding"
    },
    "primary_activity": {
      "type": [
        "string",
        "null"
      ],
      "description": "Primaire activiteit"
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Activiteiten"
    },
    "wpbr_license_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ND",
        "HND",
        "BD",
        "HBD",
        "PAC",
        "VTC",
        "PGW",
        "POB",
        "none",
        "other",
        null
      ],
      "description": "Wpbr-vergunningstype"
    },
    "wpbr_license_number": {
      "type": [
        "string",
        "null"
      ],
      "description": "Wpbr-vergunningsnummer"
    },
    "wpbr_license_valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Geldig tot"
    },
    "street_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "house_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "house_number_addition": {
      "type": [
        "string",
        "null"
      ]
    },
    "postal_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "country": {
      "type": "string",
      "default": "Nederland"
    },
    "phone": {
      "type": [
        "string",
        "null"
      ]
    },
    "email": {
      "type": [
        "string",
        "null"
      ]
    },
    "website": {
      "type": [
        "string",
        "null"
      ]
    },
    "logo_file_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "logo_file_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "ManagedFile ID voor het bedrijfslogo"
    },
    "logo_download_filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "logo_logical_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "letterhead_file_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "letterhead_file_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "ManagedFile ID voor briefpapier"
    },
    "letterhead_download_filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "letterhead_logical_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "default_cao_configuration_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Legacy/reference CAO-configuratie. Nieuwe contracten en payroll mogen niet via deze default worden afgeleid; gebruik CompanyCaoAssignment als toegestane CAO-lijst en PersonnelContract.cao_key als leidende contract-CAO."
    },
    "primary_location_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "teamhub_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Of dit bedrijf zichtbaar is in LOQ Teamhub als beschikbare onderaannemer"
    },
    "teamhub_intro": {
      "type": [
        "string",
        "null"
      ],
      "description": "Korte publieke introductie voor LOQ Teamhub"
    },
    "teamhub_contact_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Publieke contactpersoon voor Teamhub-aanvragen"
    },
    "teamhub_contact_email": {
      "type": [
        "string",
        "null"
      ],
      "description": "Publiek Teamhub-contactmailadres"
    },
    "teamhub_contact_phone": {
      "type": [
        "string",
        "null"
      ],
      "description": "Publiek Teamhub-telefoonnummer"
    },
    "teamhub_public_location_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "CompanyLocation ID van de vestiging die later op de publieke Teamhub-kaart getoond mag worden"
    },
    "teamhub_technical_certifications": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "borg_e",
          "borg_b",
          "veb_4",
          "ccv_bmi_leveren",
          "ccv_bmi_onderhoud",
          "ccv_bmi_oai_installeren",
          "ccv_oai",
          "other_technical"
        ]
      },
      "default": [],
      "description": "Legacy cache voor technische Teamhub-erkenningen. Nieuwe registratie loopt via CompanyAccreditation."
    },
    "teamhub_service_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Diensten waarvoor dit bedrijf zich via LOQ Teamhub beschikbaar stelt"
    },
    "teamhub_regions": {
      "type": "array",
      "default": [],
      "description": "Klikbaar geselecteerde regio's waar het bedrijf diensten wil aannemen via LOQ Teamhub",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "region_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "Broncode van het geselecteerde gebied, bijvoorbeeld een CBS-gemeentecode"
          },
          "label": {
            "type": "string"
          },
          "selection_type": {
            "type": "string",
            "enum": [
              "municipality",
              "province",
              "custom_geojson"
            ],
            "default": "municipality"
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "province": {
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "type": "string",
            "default": "Nederland"
          },
          "latitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "longitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "geojson": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "display_name",
    "legal_name"
  ]
}
