{
  "name": "ObjectKeySet",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "set_number": {
      "type": "integer",
      "minimum": 1,
      "description": "Automatisch volgnummer van de sleutelset binnen het object"
    },
    "display_label": {
      "type": "string"
    },
    "key_number": {
      "type": "string",
      "description": "Herkenbaar sleutelnummer van deze sleutelset; duplicaten worden niet als custody-identiteit gebruikt"
    },
    "key_number_normalized": {
      "type": "string",
      "description": "Technische hoofdletterongevoelige normalisatie voor uniekheidscontrole"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "creation_idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "creation_request_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "creation_actor_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "creation_mutation_target": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "customer_id",
    "object_id",
    "set_number",
    "display_label",
    "key_number",
    "key_number_normalized",
    "status"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
