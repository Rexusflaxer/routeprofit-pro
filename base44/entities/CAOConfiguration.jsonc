{
  "name": "CAOConfiguration",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Naam van de CAO configuratie",
      "default": "CAO Particuliere Beveiliging 2025"
    },
    "cao_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "display_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "sector": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "registration_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "version_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "active",
        "archived"
      ],
      "default": "draft"
    },
    "is_active": {
      "type": "boolean",
      "default": false
    },
    "is_payroll_ready": {
      "type": "boolean",
      "default": false
    },
    "payroll_readiness_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ready",
        "owner_not_marked_ready",
        "blocked_missing_effective_date",
        "blocked_ambiguous_effective_date",
        "blocked_missing_rules",
        "blocked_incomplete_source_coverage",
        "blocked_missing_payroll_parameters",
        "blocked_incomplete_runtime_rules",
        "manual_review_required",
        "unknown",
        null
      ],
      "default": "unknown",
      "description": "Resultaat van de owner-only CAO payroll-readiness gate. Payroll mag alleen definitief zijn bij ready + is_payroll_ready=true."
    },
    "payroll_readiness_checked_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO datetime waarop payroll_readiness_gate is berekend."
    },
    "payroll_readiness_gate": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Coverage-gate met tellingen, open payrollkritische regels en blokkades."
    },
    "rule_registry_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "description": "SHA-256 fingerprint van de CAORule registry die bij deze configuratie hoort."
    },
    "rule_registry_rule_count": {
      "type": [
        "number",
        "null"
      ],
      "description": "Aantal unieke rule_id's dat in de fingerprint is meegenomen."
    },
    "rule_registry_verified_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO datetime waarop de CAORule registry voor deze configuratie is geverifieerd."
    },
    "rule_registry_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Audit-snapshot van de CAORule registry: fingerprint, count, completeness en truncatie-informatie."
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "wage_scales": {
      "type": "object",
      "additionalProperties": true
    },
    "wage_scales_detailed": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "holidays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "pay_periods": {
      "type": [
        "object",
        "null"
      ],
      "description": "Loonperiodes per jaar \u2014 object met jaarkeys: { '2025': [...], '2026': [...] }. Elk item: { period_number, start_date, end_date, is_extra_period }.",
      "additionalProperties": true
    },
    "surcharges": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "allowances": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "leave_rules": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "sickness_rules": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "minus_hours_rules": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "overtime_rules": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "shift_change_rules": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "pension_rules": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "fund_rules": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "schiphol_rules": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "cash_value_logistics_rules": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "contract_change_rules": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "function_classification_rules": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "rule_engine_metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "source_documents_snapshot": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "coverage_summary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "surcharge_weekend": {
      "type": "number",
      "default": 35
    },
    "surcharge_night": {
      "type": "number",
      "default": 20
    },
    "surcharge_evening": {
      "type": "number",
      "default": 10
    },
    "surcharge_holiday": {
      "type": "number",
      "default": 50
    },
    "surcharge_new_years_eve_after_16": {
      "type": "number",
      "default": 100
    },
    "vacation_allowance": {
      "type": "number",
      "default": 8
    },
    "year_end_bonus": {
      "type": "number",
      "default": 2.01
    },
    "pension_base_salary_threshold": {
      "type": "number",
      "default": 16164
    },
    "pension_premium_rate_total": {
      "type": "number",
      "default": 24.1
    },
    "pension_premium_employer": {
      "type": "number",
      "default": 60
    },
    "pension_premium_employee": {
      "type": "number",
      "default": 40
    },
    "premium_sfpb": {
      "type": "number",
      "default": 0.061
    },
    "premium_paww_employee": {
      "type": "number",
      "default": 0.1
    },
    "premium_wga_employee": {
      "type": "number",
      "default": 0.81
    },
    "premium_awf_employer": {
      "type": "number",
      "default": 2.64
    },
    "premium_ww_employer_fixed": {
      "type": "number",
      "default": 0
    },
    "premium_ww_employer_variable": {
      "type": "number",
      "default": 1.5
    },
    "premium_wia_employer": {
      "type": "number",
      "default": 0.72
    },
    "premium_wga_employer": {
      "type": "number",
      "default": 1.5
    },
    "premium_zw_employer": {
      "type": "number",
      "default": 0
    },
    "tax_rate_bracket_1": {
      "type": "number",
      "default": 36.97
    },
    "tax_rate_bracket_2": {
      "type": "number",
      "default": 36.97
    },
    "tax_rate_bracket_3": {
      "type": "number",
      "default": 49.5
    },
    "tax_bracket_1_limit": {
      "type": "number",
      "default": 38098
    },
    "tax_bracket_2_limit": {
      "type": "number",
      "default": 75518
    },
    "labor_tax_credit_max": {
      "type": "number",
      "default": 5672
    },
    "approval_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_by_owner_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "codex_thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "codex_approval_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "cloudflare_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cloudflare_revision": {
      "type": [
        "string",
        "null"
      ],
      "description": "SHA256 revision hash van Cloudflare approved payload, gebruikt voor revisievergelijking"
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "automation_version": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "name"
  ]
}
