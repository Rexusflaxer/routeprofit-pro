{
  "name": "CAOConfiguration",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Naam van de CAO configuratie",
      "default": "CAO Particuliere Beveiliging 2025"
    },
    "cao_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "display_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "sector": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "registration_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "version_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "draft"
    },
    "is_active": {
      "type": "boolean",
      "default": false
    },
    "is_payroll_ready": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "wage_scales": {
      "type": "object",
      "additionalProperties": true
    },
    "wage_scales_detailed": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "holidays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "pay_periods": {
      "type": [
        "object",
        "null"
      ],
      "description": "Loonperiodes per jaar (bijv. 2026 met 14e periode), uit Cloudflare payload",
      "additionalProperties": true
    },
    "surcharges": {
      "type": [
        "object",
        "null"
      ],
      "description": "Volledige toeslagenstructuur uit payload (naast losse surcharge_* velden)",
      "additionalProperties": true
    },
    "allowances": {
      "type": [
        "object",
        "null"
      ],
      "description": "Vergoedingen config: maaltijd, pauze, consignatie, stomerij, hond, verblijf, jubileum",
      "additionalProperties": true
    },
    "leave_rules": {
      "type": [
        "object",
        "null"
      ],
      "description": "Verlofregels: wettelijk, bovenwettelijk, bijzonder verlof, ORT over verlof",
      "additionalProperties": true
    },
    "sickness_rules": {
      "type": [
        "object",
        "null"
      ],
      "description": "Ziektebetaling regels per periode en brancheancienniteit",
      "additionalProperties": true
    },
    "minus_hours_rules": {
      "type": [
        "object",
        "null"
      ],
      "description": "Minurenregels voor min/max contracten",
      "additionalProperties": true
    },
    "overtime_rules": {
      "type": [
        "object",
        "null"
      ],
      "description": "Overwerk en meeruren definitie, afbouwregeling, structureel overwerk",
      "additionalProperties": true
    },
    "shift_change_rules": {
      "type": [
        "object",
        "null"
      ],
      "description": "Verschuivingstoeslagregels: 5/10/20%, max 8/jaar, blokkadedagen, ingetrokken diensten",
      "additionalProperties": true
    },
    "pension_rules": {
      "type": [
        "object",
        "null"
      ],
      "description": "Pensioenregels en ouderenbeleid",
      "additionalProperties": true
    },
    "fund_rules": {
      "type": [
        "object",
        "null"
      ],
      "description": "Fonds-CAO regels: SFPB, sociale commissie, opleidingsfonds",
      "additionalProperties": true
    },
    "schiphol_rules": {
      "type": [
        "object",
        "null"
      ],
      "description": "Schiphol-specifieke regels en toeslagen",
      "additionalProperties": true
    },
    "cash_value_logistics_rules": {
      "type": [
        "object",
        "null"
      ],
      "description": "Cash/waardetransport specifieke regels en vergoedingen",
      "additionalProperties": true
    },
    "contract_change_rules": {
      "type": [
        "object",
        "null"
      ],
      "description": "Contractwisseling: 15.000 uur grens, vakantieoverdracht, mutatielijst",
      "additionalProperties": true
    },
    "function_classification_rules": {
      "type": [
        "object",
        "null"
      ],
      "description": "Functieclassificatie, diplomastructuur, schaalindeling",
      "additionalProperties": true
    },
    "rule_engine_metadata": {
      "type": [
        "object",
        "null"
      ],
      "description": "Coverage summary, versie-info, implementatie-status per domein",
      "additionalProperties": true
    },
    "source_documents_snapshot": {
      "type": [
        "array",
        "null"
      ],
      "description": "Snapshot van bronbestanden die gebruikt zijn voor deze CAO-versie",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "coverage_summary": {
      "type": [
        "object",
        "null"
      ],
      "description": "Per-domein coverage statistieken (IMPLEMENTED/PARTIAL/MISSING/REFERENCE tellers)",
      "additionalProperties": true
    },
    "surcharge_weekend": {
      "type": "number",
      "default": 35
    },
    "surcharge_night": {
      "type": "number",
      "default": 20
    },
    "surcharge_evening": {
      "type": "number",
      "default": 10
    },
    "surcharge_holiday": {
      "type": "number",
      "default": 50
    },
    "surcharge_new_years_eve_after_16": {
      "type": "number",
      "default": 100
    },
    "vacation_allowance": {
      "type": "number",
      "default": 8
    },
    "year_end_bonus": {
      "type": "number",
      "default": 2.01
    },
    "pension_base_salary_threshold": {
      "type": "number",
      "default": 16164
    },
    "pension_premium_rate_total": {
      "type": "number",
      "default": 24.1
    },
    "pension_premium_employer": {
      "type": "number",
      "default": 60
    },
    "pension_premium_employee": {
      "type": "number",
      "default": 40
    },
    "premium_sfpb": {
      "type": "number",
      "default": 0.061
    },
    "premium_paww_employee": {
      "type": "number",
      "default": 0.1
    },
    "premium_wga_employee": {
      "type": "number",
      "default": 0.81
    },
    "premium_awf_employer": {
      "type": "number",
      "default": 2.64
    },
    "premium_ww_employer_fixed": {
      "type": "number",
      "default": 0
    },
    "premium_ww_employer_variable": {
      "type": "number",
      "default": 1.5
    },
    "premium_wia_employer": {
      "type": "number",
      "default": 0.72
    },
    "premium_wga_employer": {
      "type": "number",
      "default": 1.5
    },
    "premium_zw_employer": {
      "type": "number",
      "default": 0
    },
    "tax_rate_bracket_1": {
      "type": "number",
      "default": 36.97
    },
    "tax_rate_bracket_2": {
      "type": "number",
      "default": 36.97
    },
    "tax_rate_bracket_3": {
      "type": "number",
      "default": 49.5
    },
    "tax_bracket_1_limit": {
      "type": "number",
      "default": 38098
    },
    "tax_bracket_2_limit": {
      "type": "number",
      "default": 75518
    },
    "labor_tax_credit_max": {
      "type": "number",
      "default": 5672
    },
    "approval_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_by_owner_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "codex_thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "codex_approval_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "cloudflare_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cloudflare_revision": {
      "type": [
        "string",
        "null"
      ],
      "description": "SHA256 revision hash van Cloudflare approved payload, gebruikt voor revisievergelijking"
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "automation_version": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "name"
  ]
}