{
  "name": "CAOConfiguration",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Naam van de CAO configuratie",
      "default": "CAO Particuliere Beveiliging 2025"
    },
    "cao_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Unieke sleutel, bijv. cao_particuliere_beveiliging"
    },
    "display_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "sector": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "registration_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "version_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "draft"
    },
    "is_active": {
      "type": "boolean",
      "default": false
    },
    "is_payroll_ready": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "wage_scales": {
      "type": "object",
      "additionalProperties": true
    },
    "wage_scales_detailed": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "holidays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "surcharge_weekend": {
      "type": "number",
      "default": 35
    },
    "surcharge_night": {
      "type": "number",
      "default": 20
    },
    "surcharge_evening": {
      "type": "number",
      "default": 10
    },
    "surcharge_holiday": {
      "type": "number",
      "default": 50
    },
    "surcharge_new_years_eve_after_16": {
      "type": "number",
      "default": 100
    },
    "vacation_allowance": {
      "type": "number",
      "default": 8
    },
    "year_end_bonus": {
      "type": "number",
      "default": 2.01
    },
    "pension_base_salary_threshold": {
      "type": "number",
      "default": 16164
    },
    "pension_premium_rate_total": {
      "type": "number",
      "default": 24.1
    },
    "pension_premium_employer": {
      "type": "number",
      "default": 60
    },
    "pension_premium_employee": {
      "type": "number",
      "default": 40
    },
    "premium_sfpb": {
      "type": "number",
      "default": 0.061
    },
    "premium_paww_employee": {
      "type": "number",
      "default": 0.1
    },
    "premium_wga_employee": {
      "type": "number",
      "default": 0.81
    },
    "premium_awf_employer": {
      "type": "number",
      "default": 2.64
    },
    "premium_ww_employer_fixed": {
      "type": "number",
      "default": 0
    },
    "premium_ww_employer_variable": {
      "type": "number",
      "default": 1.5
    },
    "premium_wia_employer": {
      "type": "number",
      "default": 0.72
    },
    "premium_wga_employer": {
      "type": "number",
      "default": 1.5
    },
    "premium_zw_employer": {
      "type": "number",
      "default": 0
    },
    "tax_rate_bracket_1": {
      "type": "number",
      "default": 36.97
    },
    "tax_rate_bracket_2": {
      "type": "number",
      "default": 36.97
    },
    "tax_rate_bracket_3": {
      "type": "number",
      "default": 49.5
    },
    "tax_bracket_1_limit": {
      "type": "number",
      "default": 38098
    },
    "tax_bracket_2_limit": {
      "type": "number",
      "default": 75518
    },
    "labor_tax_credit_max": {
      "type": "number",
      "default": 5672
    },
    "approval_source": {
      "type": [
        "string",
        "null"
      ],
      "description": "Herkomst goedkeuring, bijv. codex_chat, cloudflare_relay"
    },
    "approved_by_owner_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Naam van de eigenaar die heeft goedgekeurd"
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "Tijdstip van goedkeuring (ISO)"
    },
    "codex_thread_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Codex chat thread ID van de goedkeuring"
    },
    "codex_approval_message": {
      "type": [
        "string",
        "null"
      ],
      "description": "Goedkeuringstekst uit Codex"
    },
    "cloudflare_request_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "CF-Ray of request ID van de Cloudflare relay"
    },
    "cloudflare_revision": {
      "type": [
        "string",
        "null"
      ],
      "description": "SHA256 revision hash van de Cloudflare approved payload, gebruikt voor sync-vergelijking"
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Idempotency sleutel voor dubbele import-preventie"
    },
    "automation_version": {
      "type": [
        "string",
        "null"
      ],
      "description": "Versie van Codex CAO automation, bijv. codex-cao-automation@1.0.0"
    }
  },
  "required": [
    "name"
  ]
}