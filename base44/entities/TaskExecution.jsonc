{
  "name": "TaskExecution",
  "type": "object",
  "properties": {
    "route_execution_id": {
      "type": "string"
    },
    "source_route_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_task_id": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "sequence_index": {
      "type": "number"
    },
    "task_name": {
      "type": "string"
    },
    "object_name": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "repeat_index": {
      "type": [
        "number",
        "null"
      ]
    },
    "repeat_count": {
      "type": [
        "number",
        "null"
      ]
    },
    "split_index": {
      "type": [
        "number",
        "null"
      ]
    },
    "split_count": {
      "type": [
        "number",
        "null"
      ]
    },
    "custom_block_label": {
      "type": [
        "string",
        "null"
      ]
    },
