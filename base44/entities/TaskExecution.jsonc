{
  "name": "TaskExecution",
  "type": "object",
  "properties": {
    "route_execution_id": {
      "type": "string"
    },
    "source_route_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_task_id": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "sequence_index": {
      "type": "number"
    },
    "task_name": {
      "type": "string"
    },
    "object_name": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "operating_company_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "selling_company_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Verkopende/facturerende BV zoals vastgelegd voor deze uitvoering."
    },
    "customer_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Klant-snapshotrelatie op uitvoeringsmoment; niet achteraf herleiden uit het object."
    },
    "customer_account_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "BV/debiteurenrelatie op uitvoeringsmoment."
    },
    "customer_contract_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "customer_contract_line_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "customer_contract_rate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "customer_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Immutable allowlisted klant- en accountgegevens op uitvoeringsmoment."
    },
    "operating_company_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "selling_company_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "commercial_contract_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "commercial_rate_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "customer_billable": {
      "type": "boolean",
      "default": false
    },
    "billable_quantity_minor": {
      "type": [
        "number",
        "null"
      ],
      "description": "Factureerbare hoeveelheid in duizendsten van de gekozen eenheid."
    },
    "billable_unit": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "fixed",
        "execution",
        "minute",
        "hour",
        "unit",
        "kilometer",
        null
      ]
    },
    "billable_unit_price_cents": {
      "type": [
        "number",
        "null"
      ]
    },
    "billable_subtotal_cents": {
      "type": [
        "number",
        "null"
      ]
    },
    "billable_vat_rate_basis_points": {
      "type": [
        "number",
        "null"
      ]
    },
    "billable_tax_cents": {
      "type": [
        "number",
        "null"
      ]
    },
    "billable_total_cents": {
      "type": [
        "number",
        "null"
      ]
    },
    "billing_currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "financial_review_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "not_reviewed",
        "pending",
        "approved",
        "rejected",
        "blocked",
        null
      ]
    },
    "financial_review_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "financial_reviewed_by_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "financial_reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "billing_candidate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "billing_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "not_applicable",
        "not_ready",
        "candidate_pending",
        "candidate_blocked",
        "candidate_approved",
        "invoiced",
        "credited",
        null
      ]
    },
    "personnel_contract_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "contract_function_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "contract_cao_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "contract_routing_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "resolved",
        "blocked",
        "manual_review_required",
        "not_applicable",
        null
      ]
    },
    "contract_routing_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "repeat_index": {
      "type": [
        "number",
        "null"
      ]
    },
    "repeat_count": {
      "type": [
        "number",
        "null"
      ]
    },
    "split_index": {
      "type": [
        "number",
        "null"
      ]
    },
    "split_count": {
      "type": [
        "number",
        "null"
      ]
    },
    "custom_block_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "en_route",
        "arrived",
        "started",
        "postponed",
        "skipped",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "planned_arrival_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "planned_start_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "planned_departure_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "planned_arrival_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "planned_departure_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "actual_arrival_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "actual_started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "actual_completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "actual_postponed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "actual_skipped_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_minutes": {
      "type": "number"
    },
    "travel_from_previous_minutes": {
      "type": [
        "number",
        "null"
      ]
    },
    "distance_from_previous_km": {
      "type": [
        "number",
        "null"
      ]
    },
    "travel_to_next_minutes": {
      "type": [
        "number",
        "null"
      ]
    },
    "distance_to_next_km": {
      "type": [
        "number",
        "null"
      ]
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "address": {
      "type": [
        "string",
        "null"
      ]
    },
    "locked_to_route": {
      "type": "boolean",
      "default": false
    },
    "locked_sequence": {
      "type": "boolean",
      "default": false
    },
    "route_pin_hard": {
      "type": "boolean",
      "default": false
    },
    "arrival_deadline_time": {
      "type": [
        "string",
        "null"
      ]
    },
