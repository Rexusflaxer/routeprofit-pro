      "type": [
        "string",
        "null"
      ]
    },
    "skip_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "gps_arrival_latitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "gps_arrival_longitude": {
      "type": [
