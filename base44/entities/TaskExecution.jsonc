      ]
    },
    "gps_completed_longitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "report_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "mobile_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Optimistic concurrency-versie voor operationele en financiële mutaties."
    }
  },
  "required": [
    "route_execution_id",
    "original_task_id",
    "object_id",
    "sequence_index",
    "task_name",
    "object_name",
    "task_type",
    "status",
    "duration_minutes",
    "latitude",
    "longitude"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
