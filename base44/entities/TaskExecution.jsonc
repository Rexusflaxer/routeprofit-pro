        "en_route",
        "arrived",
        "started",
        "postponed",
        "skipped",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "planned_arrival_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "planned_start_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "planned_departure_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "planned_arrival_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "planned_departure_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "actual_arrival_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "actual_started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "actual_completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "actual_postponed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "actual_skipped_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_minutes": {
      "type": "number"
    },
    "travel_from_previous_minutes": {
      "type": [
        "number",
        "null"
      ]
    },
    "distance_from_previous_km": {
      "type": [
        "number",
        "null"
      ]
    },
    "travel_to_next_minutes": {
      "type": [
        "number",
        "null"
      ]
    },
    "distance_to_next_km": {
      "type": [
        "number",
        "null"
      ]
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "address": {
      "type": [
        "string",
        "null"
      ]
    },
    "locked_to_route": {
      "type": "boolean",
      "default": false
    },
    "locked_sequence": {
      "type": "boolean",
      "default": false
