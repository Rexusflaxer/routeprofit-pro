{
  "name": "Office",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Naam kantoor"
    },
    "address": {
      "type": "string",
      "description": "Volledig adres"
    },
    "latitude": {
      "type": "number",
      "description": "Breedtegraad"
    },
    "longitude": {
      "type": "number",
      "description": "Lengtegraad"
    }
  },
  "required": [
    "name",
    "address"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
