{
  "name": "ObjectTaskDefinition",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "security_plan_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Gekozen beveiligingsplan waarop deze taak is gebaseerd"
    },
    "security_plan_revision_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Gepubliceerde planrevisie die bij het aanmaken van de taak is gekozen."
    },
    "task_type": {
      "type": "string",
      "enum": [
        "object_security",
        "fire_closing_round",
        "external_closing_round",
        "external_control_round",
        "opening_round",
        "mobile_control_round",
        "reception",
        "closing_assistance",
        "access_control",
        "fire_watch",
        "concierge",
        "other"
      ]
    },
    "custom_task_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "continuous",
        "time_window"
      ]
    },
    "start_time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "end_time": {
      "type": "string",
      "pattern": "^(?:([01]\\d|2[0-3]):[0-5]\\d|24:00)$"
    },
    "duration_minutes": {
      "type": "number",
      "minimum": 1
    },
    "schedule_periods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "period_key": {
            "type": ["string", "null"],
            "description": "Stabiele sleutel voor occurrence-reconciliatie; legacyperioden krijgen een deterministische fallback."
          },
          "days": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "mon",
                "tue",
                "wed",
                "thu",
                "fri",
                "sat",
                "sun"
              ]
            },
            "minItems": 1,
            "maxItems": 1
          },
          "start_time": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "end_time": {
            "type": "string",
            "pattern": "^(?:([01]\\d|2[0-3]):[0-5]\\d|24:00)$"
          }
        },
        "required": [
          "days",
          "start_time",
          "end_time"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "recurrence_type": {
      "type": "string",
      "enum": [
        "weekly",
        "date_range",
        "one_time"
      ]
    },
    "weekdays": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 1,
        "maximum": 7
      },
      "uniqueItems": true,
      "default": []
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "specific_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "instructions": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "timezone": {
      "type": "string",
      "enum": [
        "Europe/Amsterdam"
      ],
      "default": "Europe/Amsterdam"
    },
    "creation_idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 180
    },
    "creation_request_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "creation_actor_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_modified_by_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_modified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "customer_id",
    "object_id",
    "task_type",
    "execution_mode",
    "start_time",
    "end_time",
    "duration_minutes",
    "recurrence_type",
    "status"
  ],
  "rls": {
    "create": false,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": false
  }
}
