{
  "name": "PlanningTaskOccurrence",
  "type": "object",
  "description": "Concrete, gedateerde planningsvraag uit een ObjectTaskDefinition. Dekking wordt afgeleid uit actieve PlanningShiftTaskSegment-records.",
  "properties": {
    "source_key": {
      "type": "string",
      "description": "Fysiek unieke snapshotsleutel. Nieuwe weekreeksen gebruiken <logical_source_key>:r<revision>; legacyrecords behouden hun bestaande sleutel."
    },
    "logical_source_key": {
      "type": ["string", "null"],
      "description": "Stabiele sleutel per reeks en servicedatum: object-task-series:<series-key>:<datum>."
    },
    "object_task_definition_id": { "type": "string" },
    "object_task_schedule_series_id": { "type": ["string", "null"] },
    "object_task_schedule_revision_id": { "type": ["string", "null"] },
    "schedule_series_key": { "type": ["string", "null"] },
    "schedule_revision_number": { "type": ["number", "null"], "minimum": 1 },
    "supersedes_task_occurrence_id": { "type": ["string", "null"] },
    "superseded_by_task_occurrence_id": { "type": ["string", "null"] },
    "definition_version": { "type": "number", "minimum": 1 },
    "schedule_period_key": { "type": "string" },
    "company_id": {
      "type": ["string", "null"],
      "description": "Legacy dienstbedrijf; niet gebruiken als arbeidscontract- of facturatiebron zodra de expliciete rollen zijn gevuld."
    },
    "selling_company_id": {
      "type": ["string", "null"],
      "description": "Verkopende/facturerende BV uit de unieke klantcontractregel."
    },
    "service_responsible_company_id": {
      "type": ["string", "null"],
      "description": "Operationeel/juridisch verantwoordelijke dienst-BV; bewust apart van verkoper en werkgever."
    },
    "customer_contract_id": { "type": ["string", "null"] },
    "customer_contract_line_id": { "type": ["string", "null"] },
    "commercial_routing_status": {
      "type": ["string", "null"],
      "enum": ["resolved", "not_applicable", "missing_contract", "ambiguous", "manual_review_required", "stale", null],
      "description": "Deterministische klantcontractroutering voor deze occurrence; ontbrekend blijft concept-toegestaan, ambigu of inconsistent vereist controle."
    },
    "commercial_routing_snapshot": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "Deterministisch bewijs van customer, objectscope, taaksoort, datum en de eventueel unieke contractregel."
    },
    "customer_id": { "type": ["string", "null"] },
    "object_id": { "type": "string" },
    "security_plan_id": { "type": ["string", "null"] },
    "security_plan_revision_id": { "type": ["string", "null"] },
    "security_plan_snapshot": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "security_plan_checksum": { "type": ["string", "null"] },
    "task_type": {
      "type": "string",
      "enum": [
        "object_security",
        "fire_closing_round",
        "external_closing_round",
        "external_control_round",
        "opening_round",
        "mobile_control_round",
        "reception",
        "closing_assistance",
        "access_control",
        "fire_watch",
        "concierge",
        "other"
      ]
    },
    "task_type_key": {
      "type": ["string", "null"],
      "description": "Canonieke taaksoortsleutel; gelijk aan task_type voor standaardtypen en specifiek voor maatwerk."
    },
    "custom_task_type": { "type": ["string", "null"] },
    "execution_mode": {
      "type": "string",
      "enum": ["continuous", "time_window"]
    },
    "service_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "window_start_time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "window_end_time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "timezone": { "type": "string", "default": "Europe/Amsterdam" },
    "required_minutes": { "type": "number", "minimum": 1 },
    "lifecycle_status": {
      "type": "string",
      "enum": ["active", "cancelled", "superseded"],
      "default": "active"
    },
    "task_name_snapshot": { "type": "string" },
    "customer_name_snapshot": { "type": ["string", "null"] },
    "object_name_snapshot": { "type": ["string", "null"] },
    "instructions_snapshot": { "type": ["string", "null"] },
    "revision": { "type": "number", "default": 1 },
    "published_revision": { "type": "number", "default": 0 },
    "last_published_correlation_id": { "type": ["string", "null"] },
    "last_modified_by_user_id": { "type": ["string", "null"] },
    "last_modified_at": { "type": ["string", "null"], "format": "date-time" },
    "metadata": {
      "type": ["object", "null"],
      "additionalProperties": true
    }
  },
  "required": [
    "source_key",
    "object_task_definition_id",
    "definition_version",
    "schedule_period_key",
    "company_id",
    "customer_id",
    "object_id",
    "task_type",
    "execution_mode",
    "service_date",
    "end_date",
    "window_start_time",
    "window_end_time",
    "timezone",
    "required_minutes",
    "lifecycle_status",
    "task_name_snapshot",
    "revision",
    "published_revision"
  ],
  "rls": {
    "create": false,
    "read": { "user_condition": { "role": "admin" } },
    "update": false,
    "delete": false
  }
}
