{
  "name": "InvoiceRun",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "run_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "collecting",
        "review",
        "approved",
        "issuing",
        "completed",
        "partial_failed",
        "failed",
        "cancelled"
      ],
      "default": "draft"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "filters_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "candidate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "invoice_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "candidate_count": {
      "type": "number",
      "default": 0
    },
    "blocked_count": {
      "type": "number",
      "default": 0
    },
    "invoice_count": {
      "type": "number",
      "default": 0
    },
    "total_cents": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "started_by_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "idempotency_key": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "company_id",
    "status",
    "period_start",
    "period_end",
    "currency",
    "idempotency_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
