{
  "name": "TaskOverride",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "ID van de taak waarop deze tijdelijke wijziging geldt"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "Datum waarop deze eenmalige wijziging geldt"
    },
    "time_window_start": {
      "type": "string",
      "description": "Aangepaste vroegste aanvangstijd (HH:MM)"
    },
    "time_window_end": {
      "type": "string",
      "description": "Aangepaste uiterste eindtijd (HH:MM)"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Aangepaste taakduur in minuten"
    },
    "reason": {
      "type": "string",
      "description": "Reden van de tijdelijke wijziging"
    },
    "is_active": {
      "type": "boolean",
      "description": "Is deze wijziging actief?",
      "default": true
    }
  },
  "required": [
    "task_id",
    "effective_date"
  ]
}