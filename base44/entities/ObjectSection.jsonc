{
  "name": "ObjectSection",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "code_normalized": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "floorplan_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "floorplan_revision": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 1
    },
    "geometry": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "polygon"
          ]
        },
        "coordinate_space": {
          "type": "string",
          "enum": [
            "normalized"
          ]
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "coordinate_space",
        "points"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "archived_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "archived_by_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "creation_idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 180
    },
    "creation_request_fingerprint": {
      "type": ["string", "null"]
    },
    "creation_actor_user_id": {
      "type": ["string", "null"]
    },
    "creation_mutation_target": {
      "type": ["string", "null"]
    },
    "customer_platform_last_mutation_key_hash": {
      "type": ["string", "null"]
    },
    "customer_platform_last_mutation_recovery": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "customer_platform_mutation_key_hashes": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "customer_platform_mutation_recoveries": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "version": {
      "type": "number",
      "minimum": 1,
      "default": 1
    }
  },
  "required": [
    "customer_id",
    "object_id",
    "code",
    "code_normalized",
    "name",
    "status",
    "version"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
