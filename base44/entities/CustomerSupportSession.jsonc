{
  "name": "CustomerSupportSession",
  "type": "object",
  "properties": {
    "actor_user_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "ticket_reference": {
      "type": "string"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "read_only": {
      "type": "boolean",
      "default": true,
      "description": "Supportsessies mogen nooit muterende portalrechten geven."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "ended",
        "expired",
        "revoked"
      ],
      "default": "active"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Maximaal zestig minuten na started_at."
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ended_by_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "actor_user_id",
    "company_id",
    "customer_id",
    "reason",
    "ticket_reference",
    "scopes",
    "read_only",
    "status",
    "started_at",
    "expires_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
