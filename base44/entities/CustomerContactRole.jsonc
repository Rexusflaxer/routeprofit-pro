{
  "name": "CustomerContactRole",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "customer_account_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "contact_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "primary",
        "billing",
        "reports",
        "planning",
        "operational",
        "emergency",
        "warning",
        "contract",
        "contract_signer",
        "portal_admin",
        "portal_user",
        "complaints",
        "other"
      ]
    },
    "object_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Leeg betekent klantbreed; expliciete IDs beperken de rol tot objecten."
    },
    "is_primary": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "archived"
      ],
      "default": "active"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "customer_id",
    "contact_id",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
