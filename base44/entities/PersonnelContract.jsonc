{
  "name": "PersonnelContract",
  "type": "object",
  "properties": {
    "personnel_id": {
      "type": "string",
      "description": "ID van de medewerker"
    },
    "company_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Werkgever/bedrijf waar dit arbeidscontract juridisch bij hoort."
    },
    "cao_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "CAO sleutel die op dit contract van toepassing is, bijv. cao_particuliere_beveiliging."
    },
    "cao_configuration_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Specifieke CAO-configuratie voor dit contract. Als leeg: resolve via CompanyCaoAssignment/company default op referentiedatum."
    },
    "contract_form": {
      "type": "string",
      "enum": [
        "bepaalde_tijd",
        "onbepaalde_tijd",
        "oproep",
        "stage",
        "uitzend",
        "payroll",
        "zzp",
        "unknown"
      ],
      "default": "unknown",
      "description": "Contractvorm conform CAO"
    },
    "employment_contract_model": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "fulltime",
        "parttime_fixed",
        "parttime_growth",
        "parttime_unknown_model",
        "call_agreement",
        "internship",
        "hired_worker",
        "zzp",
        "unknown",
        null
      ],
      "description": "CAO PB contractmodel: fulltime 144u/loonperiode, parttime vast/groeimodel, oproep, stage, inhuur/payroll, zzp of onbekend."
    },
    "parttime_contract_model": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "fixed",
        "growth",
        "not_applicable",
        "unknown",
        null
      ],
      "description": "Voor parttime arbeidsovereenkomsten: vast model of groeimodel conform CAO PB artikel 11."
    },
    "employment_contract_model_rule_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "compliant",
        "blocked",
        "manual_review_required",
        "not_applicable",
        "unknown",
        null
      ],
      "description": "Validatiestatus van fulltime/parttime/oproep contractmodel volgens CAO PB artikelen 10 en 11."
    },
    "employment_contract_model_manual_review_required": {
      "type": "boolean",
      "default": true,
      "description": "True als fulltime/parttime/oproep contractmodel niet definitief automatisch kan worden vastgesteld."
    },
    "contract_start_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "contract_end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "contract_duration_months": {
      "type": [
        "number",
        "null"
      ],
      "description": "Berekende contractduur in maanden"
    },
    "probation_period_months": {
      "type": [
        "number",
        "null"
      ],
      "description": "Berekende proeftijd in maanden conform CAO"
    },
    "probation_period_source_rule_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Bronregel voor de berekende proeftijd, bijv. CAO-PB-2024-R0315"
    },
    "probation_override_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Reden voor afwijking van CAO-standaard proeftijd"
    },
    "probation_period_manual_review_required": {
      "type": "boolean",
      "default": true,
      "description": "True als proeftijd niet definitief automatisch uit de CAO kan worden vastgesteld."
    },
    "probation_period_validation_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "compliant",
        "non_compliant",
        "calculated_not_saved",
        "manual_review_required",
        "not_applicable",
        "unknown",
        null
      ],
      "description": "Validatie van de vastgelegde proeftijd tegen de toepasselijke CAO-regel."
    },
    "cao_contract_rule_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "compliant",
        "calculated",
        "blocked",
        "manual_review_required",
        "not_applicable",
        "unknown",
        null
      ],
      "default": "unknown",
      "description": "Samenvattende status van de contractregel-runtime voor dit arbeidscontract."
    },
    "cao_contract_rule_checked_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO datetime waarop de CAO-contractregels voor dit contract zijn gecontroleerd."
    },
    "cao_contract_rule_source_rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "CAO-rule ids waarop de contractregeluitkomst is gebaseerd."
    },
    "cao_contract_rule_results": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Snapshot van toegepaste contractregels, o.a. proeftijd, grensdatums, warnings en violations."
    },
    "security_role_status": {
      "type": "string",
      "enum": [
        "aspirant_beveiliger",
        "beveiliger",
        "leidinggevende",
        "not_applicable",
        "unknown"
      ],
      "default": "unknown",
      "description": "Beveiligingsfunctie-status conform CAO"
    },
    "function_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Primaire interne functiesoort binnen dit contract, bijv. surveillant, centralist, binnendienst."
    },
    "allowed_function_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Functiesoorten/dienstsoorten die onder dit contract gepland mogen worden. Leeg betekent niet bewezen en dus manual review."
    },
    "cao_function_group": {
      "type": [
        "string",
        "null"
      ],
      "description": "Bijlage-2 functiegroep of non_security_staff voor dit contract."
    },
    "allowed_cao_function_groups": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CAO-functiegroepen waarvoor dit contract inzetbaar is."
    },
    "cao_function_level": {
      "type": [
        "string",
        "null"
      ],
      "description": "Bijlage-2 functieniveau voor dit contract."
    },
    "allowed_cao_function_levels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CAO-functieniveaus waarvoor dit contract inzetbaar is."
    },
    "allowed_task_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optionele taaktypes/dienstlabels die onder dit contract gepland mogen worden."
    },
    "contract_hours_per_week": {
      "type": [
        "number",
        "null"
      ],
      "description": "Contracturen per week voor toekomstige planning/min-max controle."
    },
    "contract_hours_per_pay_period": {
      "type": [
        "number",
        "null"
      ],
      "description": "Contracturen per loonperiode voor toekomstige CAO/payroll controles."
    },
    "fixed_hours_per_pay_period": {
      "type": [
        "number",
        "null"
      ],
      "description": "Vast aantal uren per loonperiode. Ontbreekt dit bij een oproepcontext, dan kan artikel 13 oproepovereenkomst gelden."
    },
    "min_hours_per_week": {
      "type": [
        "number",
        "null"
      ]
    },
    "max_hours_per_week": {
      "type": [
        "number",
        "null"
      ]
    },
    "min_hours_per_pay_period": {
      "type": [
        "number",
        "null"
      ],
      "description": "Minimum/garantie-uren per loonperiode bij min-maxcontract."
    },
    "max_hours_per_pay_period": {
      "type": [
        "number",
        "null"
      ],
      "description": "Maximum uren per loonperiode bij min-maxcontract."
    },
    "is_call_agreement": {
      "type": "boolean",
      "default": false,
      "description": "True als dit contract als oproepovereenkomst onder artikel 13 CAO PB is geclassificeerd."
    },
    "call_agreement_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "pre_agreement",
        "zero_hours",
        "min_max",
        "annualized_bandwidth",
        "no_work_no_pay_first_6_months",
        "not_applicable",
        "unknown",
        null
      ],
      "description": "Type oproepovereenkomst conform artikel 13: voorovereenkomst, nul-uren, min-max, jaaruren/bandbreedte of eerste-6-maanden geen werk geen loon."
    },
    "annualized_hours_with_bandwidth": {
      "type": "boolean",
      "default": false,
      "description": "True als arbeidsomvang per jaar is vastgelegd met flexibel inzetbare bandbreedte."
    },
    "annual_contract_hours": {
      "type": [
        "number",
        "null"
      ],
      "description": "Vastgelegde arbeidsomvang per jaar bij jaaruren/bandbreedte."
    },
    "no_work_no_pay_first_6_months": {
      "type": "boolean",
      "default": false,
      "description": "True als in de eerste 6 maanden alleen loon over daadwerkelijk gewerkte uren is afgesproken."
    },
    "call_notice_days": {
      "type": [
        "number",
        "null"
      ],
      "description": "Oproeptermijn in dagen. CAO PB artikel 13: 4 dagen."
    },
    "employee_notice_days": {
      "type": [
        "number",
        "null"
      ],
      "description": "Opzegtermijn werknemer bij nul-urencontract; gelijk aan oproeptermijn."
    },
    "payslip_call_agreement_indicator_required": {
      "type": "boolean",
      "default": false,
      "description": "True als loonstrook moet vermelden dat sprake is van een oproepovereenkomst."
    },
    "call_agreement_rule_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "compliant",
        "blocked",
        "manual_review_required",
        "not_applicable",
        "unknown",
        null
      ],
      "description": "Status van artikel 13 oproepovereenkomstregels."
    },
    "call_agreement_manual_review_required": {
      "type": "boolean",
      "default": false
    },
    "fixed_hours_offer_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "not_due",
        "due",
        "overdue",
        "sent",
        "accepted",
        "rejected",
        "manual_review_required",
        null
      ],
      "description": "Status van het 12-maanden-aanbod vaste arbeidsduur voor oproepovereenkomsten."
    },
    "fixed_hours_offer_sent_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "fixed_hours_offer_accepted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "fixed_hours_offer_acceptance_deadline_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "fixed_hours_offer_due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "fixed_hours_offer_deadline_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "average_hours_last_12_months": {
      "type": [
        "number",
        "null"
      ],
      "description": "Gemiddelde arbeidsomvang over de afgelopen 12 maanden, nodig voor artikel 13 loonrecht bij ontbrekend aanbod."
    },
    "fixed_hours_request_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "not_requested",
        "not_eligible",
        "decision_due",
        "decision_overdue",
        "automatic_adjustment_due",
        "decision_approved",
        "decision_rejected",
        "manual_review_required",
        null
      ],
      "description": "Status van werknemersverzoek om contracturen vast te leggen op basis van artikel 13 lid 6."
    },
    "fixed_hours_request_submitted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "fixed_hours_request_decision_sent_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "fixed_hours_request_decision": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "approved",
        "rejected",
        "pending",
        null
      ],
      "description": "Werkgeversbesluit op werknemersverzoek vaste arbeidsduur."
    },
    "fixed_hours_request_decision_deadline_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Deadline van 1 week na schriftelijk verzoek."
    },
    "fixed_hours_request_requested_hours_per_pay_period": {
      "type": [
        "number",
        "null"
      ],
      "description": "Aangevraagde arbeidsduur per loonperiode bij werknemersverzoek."
    },
    "fixed_hours_request_regular_13_weeks_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Owner/HR bevestiging dat 13 weken regelmatig en structureel meer is gewerkt."
    },
    "fixed_hours_request_qualifying_weeks": {
      "type": [
        "number",
        "null"
      ],
      "description": "Aantal kwalificerende weken voor artikel 13 lid 6, exclusief loonperioden 7, 8, 9 en 13."
    },
    "fixed_hours_request_manual_review_required": {
      "type": "boolean",
      "default": false
    },
    "internship_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "bol",
        "uwv_trial_placement",
        "reintegration_measure",
        "second_track_reintegration",
        "other",
        "not_applicable",
        "unknown",
        null
      ],
      "description": "Type stage/proefplaatsing conform CAO PB artikel 14."
    },
    "internship_rule_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "compliant",
        "blocked",
        "manual_review_required",
        "not_applicable",
        "unknown",
        null
      ],
      "description": "Status van CAO PB artikel 14 stage-/proefplaatsingsregels."
    },
    "internship_manual_review_required": {
      "type": "boolean",
      "default": false
    },
    "internship_roster_required": {
      "type": "boolean",
      "default": false,
      "description": "True als dit stagecontract volgens CAO artikel 14 altijd in het rooster moet worden opgenomen."
    },
    "internship_only_chapter_3_applies": {
      "type": "boolean",
      "default": false,
      "description": "True als voor de stagiair alleen hoofdstuk 3 van de CAO geldt."
    },
    "internship_duration_months": {
      "type": [
        "number",
        "null"
      ],
      "description": "Berekende stageduur/proefplaatsingsduur in maanden."
    },
    "internship_max_duration_months": {
      "type": [
        "number",
        "null"
      ],
      "description": "Maximale duur voor UWV-proefplaatsing conform CAO PB artikel 14: 2 maanden."
    },
    "internship_two_month_boundary_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Eerste datum waarop een UWV-proefplaatsing langer dan 2 maanden wordt."
    },
    "internship_two_month_exact_last_day": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Laatste toegestane dag bij een UWV-proefplaatsing van maximaal 2 maanden."
    },
    "internship_has_employment_contract": {
      "type": "boolean",
      "default": false,
      "description": "True betekent afwijking: stagiair heeft toch een arbeidsovereenkomst; CAO artikel 14 vereist een stage-overeenkomst."
    },
    "internship_supervision_confirmed": {
      "type": "boolean",
      "default": false
    },
    "internship_relevant_practical_experience_confirmed": {
      "type": "boolean",
      "default": false
    },
    "internship_above_strength_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "True als stagiair boven de sterkte wordt ingezet en niet in plaats van een gediplomeerde beveiliger."
    },
    "internship_not_customer_billed_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "True als de stagiair niet aan de klant wordt doorberekend."
    },
    "internship_rostered_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "True als de stagiair in het rooster wordt opgenomen."
    },
    "internship_practice_trainer_personnel_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Praktijkopleider voor de stagiair."
    },
    "internship_mentor_personnel_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "internship_mentor_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "internship_one_to_one_guidance_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "True als per dag evenveel stagiairs als praktijkopleiders worden ingezet."
    },
    "internship_uniform_label_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "True als de stagiair herkenbaar is als stagiair op het uniform."
    },
    "internship_agreement_with_institution_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "True als stage-overeenkomst ook met onderwijsinstelling of re-integratie-instelling is gesloten."
    },
    "internship_institution_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "internship_assignment_description": {
      "type": [
        "string",
        "null"
      ],
      "description": "Werkzaamheden voor de stage-opdracht."
    },
    "internship_working_times_documented": {
      "type": "boolean",
      "default": false
    },
    "internship_evaluation_agreement_documented": {
      "type": "boolean",
      "default": false
    },
    "internship_compensation_documented": {
      "type": "boolean",
      "default": false,
      "description": "True als is vastgelegd of een stagevergoeding geldt en zo ja hoe hoog die is."
    },
    "internship_compensation_applies": {
      "type": "boolean",
      "default": false
    },
    "internship_compensation_amount": {
      "type": [
        "number",
        "null"
      ]
    },
    "hired_worker_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "agency_worker",
        "payroll_worker",
        "not_applicable",
        "unknown",
        null
      ],
      "description": "Type ingehuurde arbeidskracht conform CAO PB artikel 15."
    },
    "hired_worker_rule_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "compliant",
        "blocked",
        "manual_review_required",
        "not_applicable",
        "unknown",
        null
      ],
      "description": "Status van CAO PB artikel 15 inhuur-/payrollregels."
    },
    "hired_worker_manual_review_required": {
      "type": "boolean",
      "default": false
    },
    "hired_worker_inlenersbeloning_required": {
