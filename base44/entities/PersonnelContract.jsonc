{
  "name": "PersonnelContract",
  "type": "object",
  "properties": {
    "personnel_id": {
      "type": "string",
      "description": "ID van de medewerker"
    },
    "company_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Werkgever/bedrijf waar dit arbeidscontract juridisch bij hoort."
    },
    "cao_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "CAO sleutel die op dit contract van toepassing is, bijv. cao_particuliere_beveiliging."
    },
    "cao_configuration_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Specifieke CAO-configuratie voor dit contract. Als leeg: resolve via CompanyCaoAssignment/company default op referentiedatum."
    },
    "contract_form": {
      "type": "string",
      "enum": [
        "bepaalde_tijd",
        "onbepaalde_tijd",
        "oproep",
        "stage",
        "uitzend",
        "zzp",
        "unknown"
      ],
      "default": "unknown",
      "description": "Contractvorm conform CAO"
    },
    "contract_start_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "contract_end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "contract_duration_months": {
      "type": [
        "number",
        "null"
      ],
      "description": "Berekende contractduur in maanden"
    },
    "probation_period_months": {
      "type": [
        "number",
        "null"
      ],
      "description": "Berekende proeftijd in maanden conform CAO"
    },
    "probation_period_source_rule_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Bronregel voor de berekende proeftijd, bijv. CAO-PB-2024-R0315"
    },
    "probation_override_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Reden voor afwijking van CAO-standaard proeftijd"
    },
    "probation_period_manual_review_required": {
      "type": "boolean",
      "default": true,
      "description": "True als proeftijd niet definitief automatisch uit de CAO kan worden vastgesteld."
    },
    "probation_period_validation_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "compliant",
        "non_compliant",
        "calculated_not_saved",
        "manual_review_required",
        "not_applicable",
        "unknown",
        null
      ],
      "description": "Validatie van de vastgelegde proeftijd tegen de toepasselijke CAO-regel."
    },
    "cao_contract_rule_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "compliant",
        "calculated",
        "blocked",
        "manual_review_required",
        "not_applicable",
        "unknown",
        null
      ],
      "default": "unknown",
      "description": "Samenvattende status van de contractregel-runtime voor dit arbeidscontract."
    },
    "cao_contract_rule_checked_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO datetime waarop de CAO-contractregels voor dit contract zijn gecontroleerd."
    },
    "cao_contract_rule_source_rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "CAO-rule ids waarop de contractregeluitkomst is gebaseerd."
    },
    "cao_contract_rule_results": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Snapshot van toegepaste contractregels, o.a. proeftijd, grensdatums, warnings en violations."
    },
    "security_role_status": {
      "type": "string",
      "enum": [
        "aspirant_beveiliger",
        "beveiliger",
        "leidinggevende",
        "not_applicable",
        "unknown"
      ],
      "default": "unknown",
      "description": "Beveiligingsfunctie-status conform CAO"
    },
    "function_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Primaire interne functiesoort binnen dit contract, bijv. surveillant, centralist, binnendienst."
    },
    "allowed_function_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Functiesoorten/dienstsoorten die onder dit contract gepland mogen worden. Leeg betekent niet bewezen en dus manual review."
    },
    "cao_function_group": {
      "type": [
        "string",
        "null"
      ],
      "description": "Bijlage-2 functiegroep of non_security_staff voor dit contract."
    },
    "allowed_cao_function_groups": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CAO-functiegroepen waarvoor dit contract inzetbaar is."
    },
    "cao_function_level": {
      "type": [
        "string",
        "null"
      ],
      "description": "Bijlage-2 functieniveau voor dit contract."
    },
    "allowed_cao_function_levels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CAO-functieniveaus waarvoor dit contract inzetbaar is."
    },
    "allowed_task_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optionele taaktypes/dienstlabels die onder dit contract gepland mogen worden."
    },
    "contract_hours_per_week": {
      "type": [
        "number",
        "null"
      ],
      "description": "Contracturen per week voor toekomstige planning/min-max controle."
    },
    "contract_hours_per_pay_period": {
      "type": [
        "number",
        "null"
      ],
      "description": "Contracturen per loonperiode voor toekomstige CAO/payroll controles."
    },
    "min_hours_per_week": {
      "type": [
        "number",
        "null"
      ]
    },
    "max_hours_per_week": {
      "type": [
        "number",
        "null"
      ]
    },
    "industry_seniority_pay_periods": {
      "type": [
        "number",
        "null"
      ],
      "description": "Brancheancienniteit in loonperioden (relevant voor wachtdag ziekte)"
    },
    "industry_start_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Startdatum brancheancienniteit"
    },
    "is_current": {
      "type": "boolean",
      "default": true,
      "description": "Is dit het huidige actieve contract?"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "personnel_id",
    "contract_form"
  ]
}
