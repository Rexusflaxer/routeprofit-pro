{
  "name": "PersonnelContract",
  "type": "object",
  "properties": {
    "personnel_id": {
      "type": "string",
      "description": "ID van de medewerker"
    },
    "company_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Werkgever/bedrijf waar dit arbeidscontract juridisch bij hoort."
    },
    "cao_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "CAO sleutel die op dit contract van toepassing is, bijv. cao_particuliere_beveiliging."
    },
    "cao_configuration_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Specifieke CAO-configuratie voor dit contract. Als leeg: resolve via CompanyCaoAssignment/company default op referentiedatum."
    },
    "contract_form": {
      "type": "string",
      "enum": [
        "bepaalde_tijd",
        "onbepaalde_tijd",
        "oproep",
        "stage",
        "uitzend",
        "payroll",
        "zzp",
        "unknown"
      ],
      "default": "unknown",
      "description": "Contractvorm conform CAO"
    },
    "underlying_contract_form": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "bepaalde_tijd",
        "onbepaalde_tijd",
        "unknown",
        null
      ],
      "description": "Onderliggende duurvorm voor oproepovereenkomsten: tijdelijk of vast. Nodig om o.a. proeftijdregels uit artikel 9 correct toe te passen op nul-uren- en min-maxcontracten."
    },
    "employment_contract_model": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "fulltime",
        "parttime_fixed",
        "parttime_growth",
        "parttime_unknown_model",
        "zero_hours",
        "call_agreement",
        "min_max",
        "internship",
        "bbl",
        "hired_worker",
        "zzp",
        "unknown",
        null
      ],
      "description": "CAO PB contractmodel: fulltime 144u/loonperiode, parttime vast/groeimodel, nuluren, legacy oproep, min-max, stageovereenkomst (BOL/re-integratie), leerarbeidsovereenkomst (BBL), inhuur/payroll, zzp of onbekend."
    },
    "legal_document_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "employment_agreement",
        "internship_agreement",
        "assignment_agreement",
        "unknown",
        null
      ],
      "description": "Juridisch documenttype. Dit veld bepaalt onder meer partijrollen, loonlogica en terminologie; een stageovereenkomst is geen arbeidsovereenkomst."
    },
    "learning_route": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "article_14_internship",
        "bbl",
        "not_applicable",
        "unknown",
        null
      ],
      "description": "Leerroute waarmee artikel-14-stages en BBL-arbeidsovereenkomsten strikt van elkaar worden gescheiden."
    },
    "parttime_contract_model": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "fixed",
        "growth",
        "not_applicable",
        "unknown",
        null
      ],
      "description": "Voor parttime arbeidsovereenkomsten: vast model of groeimodel conform CAO PB artikel 11."
    },
    "contract_model": {
      "type": [
        "string",
        "null"
      ],
      "description": "UX-contractmodel uit de wizard, zoals fulltime_fixed, min_max_fixed of oproep_indefinite."
    },
    "probation_agreed": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Of in dit contract een proeftijd is afgesproken."
    },
    "probation_context": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "first_contract",
        "successive_new_skills",
        "successive_same_work",
        "unknown",
        "not_applicable",
        null
      ],
      "description": "Context voor de geldigheid van een proeftijd: eerste contract of een opvolgend contract met dezelfde dan wel wezenlijk andere vaardigheden/verantwoordelijkheden."
    },
    "duration_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "fixed",
        "indefinite",
        null
      ],
      "description": "Duursoort uit de contractwizard."
    },
    "duration_option": {
      "type": [
        "string",
        "null"
      ],
      "description": "Gekozen duur uit de wizard, bijvoorbeeld 6_months, 1_year of free."
    },
    "duration_label": {
      "type": [
        "string",
        "null"
      ],
      "description": "Leesbare snapshot van de gekozen contractduur."
    },
    "wage_table_year": {
      "type": [
        "number",
        "null"
      ],
      "description": "Jaar van de salaristabel die is gebruikt bij contractaanmaak."
    },
    "hourly_rate_snapshot": {
      "type": [
        "number",
        "null"
      ],
      "description": "Uurloon uit de gekozen salaristabel/trede op het moment van contractaanmaak."
    },
    "salary_payment_frequency": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "four_weeks",
        "month",
        null
      ],
      "description": "Betaalperiode van het loon. Voor contracten onder de CAO Particuliere Beveiliging wordt automatisch vier weken vastgelegd."
    },
    "template_name_snapshot": {
      "type": [
        "string",
        "null"
      ],
      "description": "Naam van het gebruikte sjabloon op het moment van genereren."
    },
    "letterhead_name_snapshot": {
      "type": [
        "string",
        "null"
      ],
      "description": "Naam van het gebruikte briefpapier op het moment van genereren."
    },
    "employment_contract_model_rule_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "compliant",
        "blocked",
        "manual_review_required",
        "not_applicable",
        "unknown",
        null
      ],
      "description": "Validatiestatus van fulltime/parttime/oproep contractmodel volgens CAO PB artikelen 10 en 11."
    },
    "employment_contract_model_manual_review_required": {
      "type": "boolean",
      "default": true,
      "description": "True als fulltime/parttime/oproep contractmodel niet definitief automatisch kan worden vastgesteld."
    },
    "parttime_workload_change_rule_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "compliant",
        "blocked",
        "manual_review_required",
        "unknown",
        null
      ],
      "description": "Status van CAO PB artikel 11/12 regels over parttime modelwijziging en structurele arbeidsduurwijziging."
    },
    "parttime_workload_change_manual_review_required": {
      "type": "boolean",
      "default": false
    },
    "parttime_model_change_requested_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Datum waarop werknemer parttime vast/groeimodel wijziging heeft gevraagd."
    },
    "parttime_model_change_requested_model": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "parttime_fixed",
        "parttime_growth",
        null
      ],
      "description": "Aangevraagd parttime contractmodel: vast model of groeimodel."
    },
    "parttime_model_change_effective_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "parttime_model_change_effective_pay_period_number": {
      "type": [
        "number",
        "null"
      ],
      "description": "Ingangsloonperiode voor wijziging groeimodel naar vast model; CAO staat alleen 1 of 7 toe."
    },
    "parttime_model_change_decision": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "approved",
        "rejected",
        "pending",
        null
      ]
    },
    "parttime_model_change_rejection_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Schriftelijke reden bij afwijzing van parttime modelwijziging."
    },
    "parttime_model_change_weighty_business_reason_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "True als afwijzing van parttime modelwijziging is onderbouwd met zwaarwegend organisatorisch/bedrijfsbelang."
    },
    "temporary_extra_hours_agreed": {
      "type": "boolean",
      "default": false,
      "description": "True als parttimer tijdelijk meer werkt dan vaste contracturen volgens afspraak."
    },
    "temporary_extra_hours_start_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "temporary_extra_hours_end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "temporary_extra_hours_per_pay_period": {
      "type": [
        "number",
        "null"
      ],
      "description": "Aantal tijdelijke extra parttime uren per loonperiode."
    },
    "parttime_contract_hours_adjustment_requested_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Datum schriftelijk verzoek om parttime contracturen aan te passen na 13 weken structureel meer werken."
    },
    "parttime_hours_request_decision_sent_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "parttime_hours_request_decision": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "approved",
        "rejected",
        "pending",
        null
      ]
    },
    "parttime_hours_request_decision_deadline_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Deadline van 1 week na parttime contracturenverzoek."
    },
    "parttime_hours_request_requested_hours_per_pay_period": {
      "type": [
        "number",
        "null"
      ]
    },
    "parttime_hours_request_regular_13_weeks_confirmed": {
      "type": "boolean",
      "default": false
    },
    "parttime_hours_request_qualifying_weeks": {
      "type": [
        "number",
        "null"
      ]
    },
    "fulltime_to_parttime_request_submitted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "fulltime_to_parttime_requested_hours_per_pay_period": {
      "type": [
        "number",
        "null"
      ]
    },
    "fulltime_to_parttime_requested_parttime_model": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "parttime_fixed",
        "parttime_growth",
        null
      ]
    },
    "fulltime_to_parttime_decision": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "approved",
        "rejected",
        "pending",
        null
      ]
    },
    "fulltime_to_parttime_rejection_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Schriftelijke reden bij afwijzing van fulltime-naar-parttime verzoek."
    },
    "fulltime_to_parttime_weighty_business_reason_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "True als afwijzing is onderbouwd met zwaarwegend bedrijfs- of dienstbelang."
    },
    "parttime_upward_wfw_request_submitted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Datum verzoek om parttime arbeidsduur naar boven aan te passen; valt onder Wet flexibel werken."
    },
    "parttime_upward_wfw_requested_hours_per_pay_period": {
      "type": [
        "number",
        "null"
      ]
    },
    "parttime_upward_wfw_decision": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "approved",
        "rejected",
        "pending",
        null
      ]
    },
    "social_committee_advice_requested": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "True als bij afwijzing advies van de Sociale Commissie is gevraagd."
    },
    "social_committee_advice_reference": {
      "type": [
        "string",
        "null"
      ],
      "description": "Referentie naar adviesverzoek of uitspraak van de Sociale Commissie."
    },
    "written_contract_model_terms_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Bevestigt dat de schriftelijke arbeidsovereenkomst alle onderdelen uit de CAO-modelarbeidsovereenkomst bevat."
    },
    "non_compete_clause_present": {
      "type": "boolean",
      "default": false,
      "description": "True als het contract een concurrentiebeding bevat. Voor beveiligers blokkeert dit CAO PB artikel 9 lid 1c."
    },
    "non_compete_clause_absent_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Bevestigt expliciet dat geen concurrentiebeding in het beveiligerscontract staat."
    },
    "wpbr_required": {
      "type": "boolean",
      "default": false,
      "description": "True als voor dit contract toestemming van de overheid/WPBR vereist is omdat de werknemer beveiligingswerk verricht."
    },
    "wpbr_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "not_required",
        "not_started",
        "requested",
        "approved",
        "rejected",
        "expired",
        null
      ],
      "description": "Status van de overheidstoestemming/WPBR voor beveiligingswerk."
    },
    "wpbr_authority": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "korpschef",
        "kmar",
        "justis",
        "other",
        null
      ]
    },
    "wpbr_permission_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "wpbr_permission_valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "wpbr_permission_valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "wpbr_permission_rule_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "compliant",
        "blocked",
        "manual_review_required",
        "not_applicable",
        "unknown",
        null
      ],
      "description": "Validatiestatus van CAO PB artikel 9 lid 1d overheidstoestemming/WPBR."
    },
    "wpbr_permission_manual_review_required": {
      "type": "boolean",
      "default": false
    },
    "contract_clause_rule_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "compliant",
        "blocked",
        "manual_review_required",
        "unknown",
        null
      ],
      "description": "Validatiestatus van CAO PB artikel 9 contractclausules, waaronder modelcontract en concurrentiebeding."
    },
    "contract_clause_manual_review_required": {
      "type": "boolean",
      "default": true
    },
    "contract_start_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "contract_end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "work_location": {
      "type": [
        "string",
        "null"
      ],
      "description": "Contractuele standplaats of primaire werkplek."
    },
    "work_area": {
      "type": [
        "string",
        "null"
      ],
      "description": "Werkgebied waarbinnen inzet op wisselende locaties kan plaatsvinden."
    },
    "employer_representative_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Naam van de persoon die de arbeidsovereenkomst namens werkgever ondertekent."
    },
    "employer_representative_function": {
      "type": [
        "string",
        "null"
      ],
      "description": "Functie van de persoon die namens werkgever ondertekent."
    },
    "signing_place": {
      "type": [
        "string",
        "null"
      ],
      "description": "Plaats waar de arbeidsovereenkomst wordt ondertekend."
    },
    "signing_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Datum waarop de arbeidsovereenkomst wordt ondertekend."
    },
    "fixed_term_end_notice_sent_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Datum waarop schriftelijk is aangezegd of het bepaalde-tijd contract wel/niet wordt verlengd."
    },
    "fixed_term_end_notice_deadline_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Uiterste aanzegdatum: 1 maand voor contract_end_date."
    },
    "fixed_term_end_notice_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "not_due",
        "sent",
        "missing_due",
        "late",
        "not_applicable",
        null
      ],
      "description": "Status van de aanzegging voor einde bepaalde tijd conform CAO PB artikel 9."
    },
    "fixed_term_renewal_decision": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "renew",
        "not_renew",
        "unknown",
        null
      ],
      "description": "Inhoud van schriftelijk bericht of arbeidsovereenkomst wel/niet wordt verlengd."
    },
    "contract_termination_rule_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "compliant",
        "blocked",
        "manual_review_required",
        "unknown",
        null
      ],
      "description": "Validatiestatus van CAO PB artikel 9 contracteinde/opzegregels."
    },
    "contract_termination_manual_review_required": {
      "type": "boolean",
      "default": true
    },
    "mutual_longer_notice_weeks": {
      "type": [
        "number",
        "null"
      ],
      "description": "Schriftelijk overeengekomen gelijke langere opzegtermijn bij onbepaalde tijd, in weken."
    },
    "employee_aow_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Datum waarop werknemer AOW-leeftijd bereikt; contract eindigt dan van rechtswege tenzij doorwerken na AOW is bevestigd."
    },
    "works_after_aow": {
      "type": "boolean",
      "default": false
    },
    "employee_already_receives_aow": {
      "type": "boolean",
      "default": false
    },
    "mbo_security_practice_experience": {
      "type": "boolean",
      "default": false,
      "description": "True als werknemer praktijkervaring voor mbo opleiding beveiliger bij werkgever opdoet."
    },
    "contract_duration_months": {
      "type": [
        "number",
        "null"
      ],
      "description": "Berekende contractduur in maanden"
    },
    "probation_period_months": {
      "type": [
        "number",
        "null"
      ],
      "description": "Berekende proeftijd in maanden conform CAO"
    },
    "probation_period_source_rule_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Bronregel voor de berekende proeftijd, bijv. CAO-PB-2024-R0315"
    },
    "probation_override_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Reden voor afwijking van CAO-standaard proeftijd"
    },
    "probation_period_manual_review_required": {
      "type": "boolean",
      "default": true,
      "description": "True als proeftijd niet definitief automatisch uit de CAO kan worden vastgesteld."
    },
    "probation_period_validation_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "compliant",
        "non_compliant",
        "calculated_not_saved",
        "manual_review_required",
        "not_applicable",
        "unknown",
        null
      ],
      "description": "Validatie van de vastgelegde proeftijd tegen de toepasselijke CAO-regel."
    },
    "cao_contract_rule_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "compliant",
        "calculated",
        "blocked",
        "manual_review_required",
        "not_applicable",
        "unknown",
        null
      ],
      "default": "unknown",
      "description": "Samenvattende status van de contractregel-runtime voor dit arbeidscontract."
    },
    "cao_contract_rule_checked_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO datetime waarop de CAO-contractregels voor dit contract zijn gecontroleerd."
    },
    "cao_contract_rule_source_rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "CAO-rule ids waarop de contractregeluitkomst is gebaseerd."
    },
    "cao_contract_rule_results": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Snapshot van toegepaste contractregels, o.a. proeftijd, grensdatums, warnings en violations."
    },
    "contract_context_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "draft_missing_context",
        "context_ready",
        "blocked",
        "manual_review_required",
        "compliant",
        "unknown",
        null
      ],
      "default": "unknown",
      "description": "Auditstatus van de minimale contractbasis: company_id, cao_key, contract_start_date en functie-/CAO-scope. draft_missing_context mag niet automatisch planning/payroll dragen."
    },
    "contract_context_missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Ontbrekende contractbasisvelden die eerst moeten worden aangevuld voordat het contract definitief kan worden gebruikt."
    },
    "contract_context_checked_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO datetime waarop de minimale contractcontext voor het laatst is beoordeeld."
    },
    "planning_allowed": {
      "type": "boolean",
      "default": false,
      "description": "True als deze contractsnapshot volgens de contractcontext en contractregels planmatig gebruikt mag worden. Dienstspecifieke roosterregels blijven apart gelden."
    },
    "contract_final_allowed": {
      "type": "boolean",
      "default": false,
      "description": "True als dit arbeidscontract CAO-contractregelmatig definitief is beoordeeld zonder blokkades of handmatige review."
    },
    "payroll_final_allowed": {
      "type": "boolean",
      "default": false,
      "description": "True als dit contract als payroll-final basis mag dienen. Berekening per dienst/loonperiode controleert daarna nog dienstspecifieke regels."
    },
    "security_role_status": {
