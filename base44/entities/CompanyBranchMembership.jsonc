{
  "name": "CompanyBranchMembership",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID van het bedrijf"
    },
    "association_type": {
      "type": "string",
      "enum": [
        "nederlandse_veiligheidsbranche",
        "veb",
        "techniek_nederland",
        "other"
      ],
      "description": "Type branchevereniging"
    },
    "association_name": {
      "type": "string",
      "description": "Naam van de branchevereniging"
    },
    "membership_number": {
      "type": [
        "string",
        "null"
      ],
      "description": "Lidnummer of registratienummer"
    },
    "membership_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Lidmaatschapstype of categorie"
    },
    "member_since": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Lid sinds"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Geldig tot of eerstvolgende hercontrole"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending_review",
        "expired",
        "cancelled"
      ],
      "default": "active"
    },
    "public_profile_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "Publieke ledenpagina of verificatielink"
    },
    "document_file_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_file_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_download_filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_logical_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
