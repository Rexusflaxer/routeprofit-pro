{
  "name": "CompanyContractClause",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Bedrijf waar deze contractclausule bij hoort."
    },
    "title": {
      "type": "string",
      "description": "Interne titel van de clausule."
    },
    "scope": {
      "type": [
        "string",
        "null"
      ],
      "description": "Onderdeel waarvoor de clausule bedoeld is, bijvoorbeeld employment_contracts, customer_contracts of zzp_framework_agreements."
    },
    "clause_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Type clausule binnen het gekozen onderdeel, bijvoorbeeld confidentiality, liability of payment_terms."
    },
    "body": {
      "type": "string",
      "description": "Clausuletekst met optionele placeholders zoals {{medewerker.naam}}."
    },
    "sections": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "description": "Geordende onderdelen van de clausule. In de editor worden deze als x.1, x.2 enzovoort getoond."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Volgorde waarin clausules standaard worden aangeboden."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "placeholders": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "company_id",
    "title",
    "body"
  ]
}
