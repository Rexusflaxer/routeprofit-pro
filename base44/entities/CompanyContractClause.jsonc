{
  "name": "CompanyContractClause",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Bedrijf waar deze contractclausule bij hoort."
    },
    "title": {
      "type": "string",
      "description": "Interne titel van de clausule."
    },
    "scope": {
      "type": [
        "string",
        "null"
      ],
      "description": "Onderdeel waarvoor de clausule bedoeld is, bijvoorbeeld employment_contracts, customer_contracts of zzp_framework_agreements."
    },
    "clause_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Type clausule binnen het gekozen onderdeel, bijvoorbeeld confidentiality, liability of payment_terms."
    },
    "license_scope": {
      "type": [
        "string",
        "null"
      ],
      "description": "Vergunning- of werkveldcontext waarvoor de clausule bedoeld is, bijvoorbeeld ND, PAC, POB, all_security of not_applicable."
    },
    "function_profile": {
      "type": [
        "string",
        "null"
      ],
      "description": "Functieprofiel dat juridisch en operationeel relevant is voor de clausule."
    },
    "risk_level": {
      "type": [
        "string",
        "null"
      ],
      "description": "Risiconiveau van de clausule: green, orange, red of blocked."
    },
    "review_required": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Geeft aan of juridische controle nodig is voordat de clausule definitief wordt gebruikt."
    },
    "body": {
      "type": "string",
      "description": "Clausuletekst met optionele placeholders zoals {{medewerker.naam}} of {$medewerker_volledige_naam}."
    },
    "sections": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "description": "Geordende onderdelen van de clausule. In de editor worden deze als x.1, x.2 enzovoort getoond."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Volgorde waarin clausules standaard worden aangeboden."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "placeholders": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "company_id",
    "title",
    "body"
  ]
}
