{
  "name": "CAOPayrollCorrection",
  "type": "object",
  "properties": {
    "correction_key": {
      "type": "string",
      "description": "Semantische idempotency key voor deze correctiekandidaat, gebaseerd op CAO-wijziging + geraakte PayrollCalculationRun."
    },
    "cao_change_review_id": {
      "type": "string"
    },
    "import_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "affected_payroll_run_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "PayrollCalculationRun die geraakt wordt. Null betekent dat er nog geen concrete run gevonden is maar wel correctierisico bestaat."
    },
    "personnel_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "route_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cao_configuration_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cao_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "CAO sleutel waarop deze correctie ziet. Voorkomt dat retroactieve wijzigingen van de ene CAO loonruns van een andere CAO raken."
    },
    "cao_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "rule_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "field_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "effective_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "effective_from_source": {
      "type": [
        "string",
        "null"
      ],
      "description": "Herkomst van de gebruikte ingangsdatum, bijv. change.effective_from of candidate_configuration.valid_from."
    },
    "effective_from_inferred": {
      "type": "boolean",
      "default": false,
      "description": "True als de ingangsdatum is afgeleid en niet expliciet op de wijziging stond."
    },
    "effective_date_manual_review_required": {
      "type": "boolean",
      "default": false,
      "description": "True als de ingangsdatum/werkingsperiode niet veilig automatisch kan worden toegepast."
    },
    "effective_date_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Auditnotities over ontbrekende, afgeleide of conflicterende ingangsdata."
    },
    "affected_overlap_start": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Eerste datum binnen de payrollrun die door deze CAO-wijziging geraakt wordt."
    },
    "affected_overlap_end": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Laatste datum binnen de payrollrun die door deze CAO-wijziging geraakt wordt."
    },
    "affected_overlap_days": {
      "type": [
        "number",
        "null"
      ],
      "description": "Aantal kalenderdagen in de doorsnede tussen payrollperiode en CAO-wijzigingsperiode."
    },
    "correction_match_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "exact_pay_period_overlap",
        "legacy_year_only_possible_overlap",
        "unmatched_no_existing_run",
        "manual_review_effective_date",
        "manual_review_missing_cao_key",
        null
      ],
      "description": "Hoe deze correctiekandidaat aan payroll is gekoppeld. Exacte overlap is automatisch afgebakend; legacy/year-only vereist review."
    },
    "correction_match_evidence": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Auditbewijs voor de match: payrollperiode, wijzigingsperiode, overlapsegment en gebruikte matchingstrategie."
    },
    "pay_period_year": {
      "type": [
        "number",
        "null"
      ]
    },
    "pay_period_number": {
      "type": [
        "number",
        "null"
      ]
    },
    "pay_period_start": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "pay_period_end": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "queued",
        "applied",
        "skipped_no_affected_run",
        "manual_review_required",
        "superseded"
      ],
      "default": "candidate"
    },
    "payroll_impact": {
      "type": "boolean",
      "default": true
    },
    "correction_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "old_calculation_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "new_calculation_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "delta_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "created_at": {
      "type": "string"
    },
    "created_by_function": {
      "type": "string",
      "default": "queueCaoPayrollCorrections"
    },
    "queued_for_pay_period_year": {
      "type": [
        "number",
        "null"
      ]
    },
    "queued_for_pay_period_number": {
      "type": [
        "number",
        "null"
      ]
    },
    "queued_for_pay_period_start": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Startdatum van de loonperiode waarin deze correctie moet worden meegenomen."
    },
    "queued_for_pay_period_end": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Einddatum van de loonperiode waarin deze correctie moet worden meegenomen."
    },
    "queue_target_match_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "explicit_request",
        "next_open_pay_period",
        "manual_review_missing_pay_periods",
        "manual_review_no_open_pay_period",
        null
      ],
      "description": "Hoe de loonperiode voor verwerking van deze correctie is bepaald."
    },
    "queue_target_manual_review_required": {
      "type": "boolean",
      "default": false,
      "description": "True als niet audit-proof bepaald kon worden in welke volgende loonrun de correctie moet landen."
    },
    "queue_target_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Auditnotities over het bepalen van de correctie-doelloonperiode."
    },
    "queue_target_evidence": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Auditbewijs voor de gekozen doelloonperiode."
    },
    "applied_payroll_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "correction_key",
    "cao_change_review_id",
    "created_at",
    "created_by_function"
  ]
}
