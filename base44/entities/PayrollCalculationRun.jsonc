{
  "name": "PayrollCalculationRun",
  "type": "object",
  "properties": {
    "personnel_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "route_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cao_configuration_id": {
      "type": "string"
    },
    "cao_version_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "cao_revision": {
      "type": [
        "string",
        "null"
      ],
      "description": "Cloudflare/Codex CAO revision waarmee deze run is berekend."
    },
    "cao_payroll_readiness_status": {
      "type": [
        "string",
        "null"
      ],
      "description": "Payroll-readiness status van de gebruikte CAO tijdens deze run."
    },
    "correction_run_for_review_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CAOChangeReview IDs waarvoor deze loonrun een correctie verwerkt."
    },
    "supersedes_payroll_run_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Eerdere payroll runs die door deze correctierun worden gecorrigeerd."
    },
    "pay_period_year": {
      "type": "number"
    },
    "pay_period_number": {
      "type": "number"
    },
    "calculation_input": {
      "type": "object",
      "additionalProperties": true
    },
    "calculation_output": {
      "type": "object",
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "created_at": {
      "type": "string"
    },
    "created_by_function": {
      "type": "string"
    }
  },
  "required": [
    "cao_configuration_id",
    "pay_period_year",
    "pay_period_number",
    "created_at",
    "created_by_function"
  ]
}
