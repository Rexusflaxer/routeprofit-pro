{
  "name": "PayrollCalculationRun",
  "type": "object",
  "properties": {
    "personnel_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "route_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "route_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Alle route IDs die in deze loonrun voorkomen. route_id is alleen gevuld als exact één route audit-proof is vastgesteld."
    },
    "company_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Werkgever/bedrijf waarop deze loonrun ziet. Null als meerdere bedrijven voorkomen of als bedrijf niet audit-proof is vastgesteld."
    },
    "company_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Alle werkgevers/bedrijven die via contractresolutie of dienstcontext in deze loonrun voorkomen."
    },
    "contract_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Arbeidscontracten die voor de diensten in deze loonrun zijn gebruikt."
    },
    "contract_resolution_summary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Audit-samenvatting van contractresolutie: routes, bedrijven, contracten, gemengde context en payroll-final bewijs."
    },
    "cao_configuration_id": {
      "type": "string"
    },
    "cao_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "CAO sleutel waarmee deze loonrun is berekend, bijv. cao_particuliere_beveiliging. Nodig om retroactieve correcties per CAO te isoleren."
    },
    "cao_version_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "cao_revision": {
      "type": [
        "string",
        "null"
      ],
      "description": "Cloudflare/Codex CAO revision waarmee deze run is berekend."
    },
    "cao_payroll_readiness_status": {
      "type": [
        "string",
        "null"
      ],
      "description": "Payroll-readiness status van de gebruikte CAO tijdens deze run."
    },
    "cao_rule_registry_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "description": "SHA-256 fingerprint van de CAORule registry waarmee deze loonrun is berekend."
    },
    "cao_rule_registry_rule_count": {
      "type": [
        "number",
        "null"
      ],
      "description": "Aantal unieke CAORule records dat in de registry fingerprint is meegenomen."
    },
    "cao_rule_registry_verified_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO datetime waarop de gebruikte CAORule registry is geverifieerd."
    },
    "cao_rule_registry_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Snapshot van de CAORule registry evidence die bij deze payrollrun hoort."
    },
    "correction_run_for_review_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CAOChangeReview IDs waarvoor deze loonrun een correctie verwerkt."
    },
    "supersedes_payroll_run_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Eerdere payroll runs die door deze correctierun worden gecorrigeerd."
    },
    "corrected_by_payroll_run_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Latere PayrollCalculationRun IDs die deze run corrigeren."
    },
    "cao_correction_applied_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO datetime waarop de laatste CAO-correctie voor deze run als toegepast is gemarkeerd."
    },
    "pay_period_year": {
      "type": "number"
    },
    "pay_period_number": {
      "type": "number"
    },
    "pay_period_start": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Startdatum van de loonperiode waarop deze berekening ziet."
    },
    "pay_period_end": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Einddatum van de loonperiode waarop deze berekening ziet."
    },
    "payroll_run_status": {
      "type": "string",
      "enum": [
        "draft",
        "calculated",
        "approved",
        "exported",
        "paid",
        "corrected",
        "voided"
      ],
      "default": "calculated",
      "description": "Lifecycle-status van deze payrollberekening."
    },
    "payroll_exported_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "payroll_paid_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "requires_cao_recalculation": {
      "type": "boolean",
      "default": false,
      "description": "True als een retroactieve CAO-wijziging deze run raakt."
    },
    "cao_recalculation_reason_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CAOChangeReview IDs waardoor herrekening nodig is."
    },
    "calculation_input": {
      "type": "object",
      "additionalProperties": true
    },
    "calculation_output": {
      "type": "object",
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "created_at": {
      "type": "string"
    },
    "created_by_function": {
      "type": "string"
    }
  },
  "required": [
    "cao_configuration_id",
    "pay_period_year",
    "pay_period_number",
    "created_at",
    "created_by_function"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
