{
  "name": "CompanyContractTemplate",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Bedrijf waar dit contractsjabloon bij hoort."
    },
    "name": {
      "type": "string",
      "description": "Verplichte referentie van de template. Uniek binnen bedrijf, documentsoort, CAO en contractmodel; opvolgende versies delen dezelfde referentie."
    },
    "reference_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Genormaliseerde referentie voor hoofdletterongevoelige uniciteitscontrole."
    },
    "template_family_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Stabiele sleutel waarmee alle versies binnen dezelfde documentsoort, CAO, contractvorm en referentie worden gegroepeerd."
    },
    "version_source_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "ID van de templateversie waarop deze opvolgende versie is gebaseerd."
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "template_type": {
      "type": "string",
      "enum": [
        "employment_contract",
        "assignment_agreement",
        "sales_contract",
        "subcontractor_framework_agreement"
      ],
      "default": "employment_contract"
    },
    "contract_form_scope": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optioneel contractvorm-bereik, zoals fulltime, parttime, oproep of min-max."
    },
    "employment_model_scope": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optioneel uren-/dienstverbandmodel voor filtering in de contractwizard, zoals fulltime, parttime_fixed, min_max of call_agreement."
    },
    "probation_scope": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "any",
        "with_probation",
        "without_probation",
        "not_applicable",
        null
      ],
      "description": "Geeft aan of dit sjabloon bedoeld is voor contracten met of zonder proeftijd."
    },
    "duration_type_scope": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "any",
        "fixed",
        "indefinite",
        null
      ],
      "description": "Duursoort waarop het sjabloon van toepassing is."
    },
    "duration_options": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "Optionele duurkeuzes waarvoor dit sjabloon zichtbaar is, bijv. 6_months, 1_year of free."
    },
    "visible_in_contract_wizard": {
      "type": "boolean",
      "default": true,
      "description": "Als false blijft de template beheersbaar maar verschijnt hij niet in de medewerker-contractwizard."
    },
    "cao_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "function_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "default_letterhead_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Automatisch oplopend versienummer binnen dezelfde templatereferentie."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "body": {
      "type": "string",
      "description": "Genormaliseerde platte template-inhoud met {$...}-placeholders. Rijke artikelblokken en opmaak staan versiegebonden in editor_blocks."
    },
    "editor_blocks": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      },
      "description": "Geordende artikelblokken met titel, veilige rich-textinhoud en stabiele blok-ID's."
    },
    "clauses": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      },
      "description": "Optionele geordende clausules/artikelen voor latere fijnmazige bewerking."
    },
    "clause_ids": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "Geordende verwijzingen naar herbruikbare CompanyContractClause-records die in de templatebody zijn ingevoegd."
    },
    "placeholders": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ],
      "description": "Bevat onder meer template_family_key, version_source_id, editor_blocks en auditmetadata."
    }
  },
  "required": [
    "company_id",
    "name",
    "body"
  ]
}
