{
  "name": "WarningAddressAvailabilityOverride",
  "type": "object",
  "properties": {
    "warning_address_id": {
      "type": "string",
      "description": "Waarschuwingsadres waarop de uitzondering geldt"
    },
    "customer_id": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "dates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Specifieke kalenderdatums waarop de weekplanning wordt overschreven"
    },
    "availability_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "available",
        "emergency_only",
        "unavailable",
        null
      ],
      "description": "Legacy dagstatus voor bestaande uitzonderingen"
    },
    "availability_periods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_time": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):(?:00|30)$"
          },
          "end_time": {
            "type": "string",
            "pattern": "^(?:([01]\\d|2[0-3]):(?:00|30)|24:00)$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "available",
              "emergency_only"
            ]
          }
        },
        "required": [
          "start_time",
          "end_time",
          "kind"
        ],
        "additionalProperties": false
      },
      "default": [],
      "description": "Datumgebonden bereikbaarheidsblokken per half uur"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "record_status": {
      "type": "string",
      "enum": ["active", "deleted"],
      "default": "active",
      "description": "Append-only projectiestatus; deleted is een datumgebonden tombstone"
    },
    "supersedes_override_id": {
      "type": ["string", "null"]
    },
    "created_by_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_by_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "creation_idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "creation_request_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "description": "Fingerprint van het oorspronkelijke API-verzoek voor forensische idempotencycontrole"
    },
    "creation_payload_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "description": "Stabiele fingerprint van datum, inhoud, status en voorganger voor veilig partial-create herstel"
    },
    "creation_actor_user_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Backofficegebruiker aan wie dit immutable override-record is gebonden"
    },
    "creation_mutation_target": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonieke mutatiedoelbinding voor veilig partial-create herstel"
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "warning_address_id",
    "customer_id",
    "object_id",
    "dates"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
