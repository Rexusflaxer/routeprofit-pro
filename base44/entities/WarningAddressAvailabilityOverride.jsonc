{
  "name": "WarningAddressAvailabilityOverride",
  "type": "object",
  "properties": {
    "warning_address_id": {
      "type": "string",
      "description": "Waarschuwingsadres waarop de uitzondering geldt"
    },
    "customer_id": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "dates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Specifieke kalenderdatums waarop de weekplanning wordt overschreven"
    },
    "availability_status": {
      "type": "string",
      "enum": [
        "available",
        "emergency_only",
        "unavailable"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "warning_address_id",
    "customer_id",
    "object_id",
    "dates",
    "availability_status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}