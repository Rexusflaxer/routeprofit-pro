{
  "name": "WarningAddressAvailabilityOverride",
  "type": "object",
  "properties": {
    "warning_address_id": {
      "type": "string",
      "description": "Waarschuwingsadres waarop de uitzondering geldt"
    },
    "customer_id": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "dates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Specifieke kalenderdatums waarop de weekplanning wordt overschreven"
    },
    "availability_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "available",
        "emergency_only",
        "unavailable",
        null
      ],
      "description": "Legacy dagstatus voor bestaande uitzonderingen"
    },
    "availability_periods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_time": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):(?:00|30)$"
          },
          "end_time": {
            "type": "string",
            "pattern": "^(?:([01]\\d|2[0-3]):(?:00|30)|24:00)$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "available",
              "emergency_only"
            ]
          }
        },
        "required": [
          "start_time",
          "end_time",
          "kind"
        ],
        "additionalProperties": false
      },
      "default": [],
      "description": "Datumgebonden bereikbaarheidsblokken per half uur"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "warning_address_id",
    "customer_id",
    "object_id",
    "dates"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}