{
  "name": "ManagedFile",
  "type": "object",
  "properties": {
    "owner_type": {
      "type": "string",
      "enum": [
        "company",
        "personnel",
        "customer",
        "object",
        "route",
        "vehicle",
        "system"
      ],
      "description": "Primair domein waar het bestand bij hoort."
    },
    "owner_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "ID van de primaire eigenaar. Kan leeg zijn tijdens een concept-upload."
    },
    "company_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Bedrijfscontainer waar het bestand commercieel en administratief onder valt."
    },
    "customer_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Klant waartoe dit bestand behoort."
    },
    "customer_account_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optionele BV/debiteurenrelatie van het bestand."
    },
    "object_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optionele objectscope; gevoelige objectbestanden blijven objectgebonden."
    },
    "publication_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "CustomerPortalPublication die deze exacte bestandsversie veilig publiceert."
    },
    "upload_session_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Tijdelijke container voor uploads voordat het definitieve record bestaat."
    },
    "tenant_container_key": {
      "type": "string",
      "description": "Stabiele tenant/container sleutel, bijv. company:<company_id>."
    },
    "owner_container_key": {
      "type": "string",
      "description": "Stabiele eigenaar/container sleutel, bijv. personnel:<personnel_id>."
    },
    "access_scope": {
      "type": "string",
      "enum": [
        "company",
        "personnel",
        "customer_portal",
        "system",
        "public"
      ],
      "default": "company"
    },
    "domain": {
      "type": "string",
      "enum": [
        "compliance",
        "identity",
        "payroll",
        "branding",
        "commercial",
        "operations",
        "reporting",
        "other"
      ]
    },
    "category": {
      "type": "string",
      "description": "Specifieke documentcategorie, bijv. company_wpbr_license of bank_account_proof."
    },
    "source_entity": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_field": {
      "type": [
        "string",
        "null"
      ]
    },
    "file_url": {
      "type": "string"
    },
    "file_uri": {
      "type": [
        "string",
        "null"
      ],
      "description": "Stabiele private storage-URI; nooit rechtstreeks aan portalgebruikers teruggeven."
    },
    "storage_filename": {
      "type": [
        "string",
        "null"
      ],
      "description": "Werkelijke naam van het opgeslagen object. Bij encryptie eindigt deze meestal op .enc."
    },
    "original_filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "display_filename": {
      "type": "string"
    },
    "display_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Compatibele alias; nieuwe writers vullen ook display_filename."
    },
    "download_filename": {
      "type": "string"
    },
    "logical_path": {
      "type": "string",
      "description": "Pad voor export/backups en menselijke organisatie."
    },
    "folder_path": {
      "type": "string"
    },
    "extension": {
      "type": [
        "string",
        "null"
      ]
    },
    "mime_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "stored_mime_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "MIME-type van het opgeslagen object. Kan afwijken bij encrypted blobs."
    },
    "size_bytes": {
      "type": [
        "number",
        "null"
      ]
    },
    "ciphertext_size_bytes": {
      "type": [
        "number",
        "null"
      ]
    },
    "encrypted": {
      "type": "boolean",
      "default": false,
      "description": "True als het opgeslagen bestand applicatie-level versleuteld is."
    },
    "encryption_algorithm": {
      "type": [
        "string",
        "null"
      ],
      "description": "Bijv. AES-256-GCM."
    },
    "encryption_key_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Server-side master key id waarmee de data key is gewrapt."
    },
    "encryption_iv": {
      "type": [
        "string",
        "null"
      ],
      "description": "Base64 IV/nonce voor decryptie van het bestand."
    },
    "encrypted_data_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Base64 gewrapte per-file data key."
    },
    "key_wrap_algorithm": {
      "type": [
        "string",
        "null"
      ]
    },
    "key_wrap_iv": {
      "type": [
        "string",
        "null"
      ],
      "description": "Base64 IV/nonce voor het unwrap proces."
    },
    "plaintext_sha256": {
      "type": [
        "string",
        "null"
      ],
      "description": "Base64 SHA-256 hash van het originele bestand voor integriteitscontrole na decryptie."
    },
    "ciphertext_sha256": {
      "type": [
        "string",
        "null"
      ],
      "description": "Base64 SHA-256 hash van het opgeslagen encrypted object."
    },
    "document_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "deleted"
      ],
      "default": "active"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "is_sensitive": {
      "type": "boolean",
      "default": false
    },
    "security_classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "strictly_confidential"
      ],
      "default": "confidential"
    },
    "storage_visibility": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "private",
        "public",
        null
      ],
      "default": "private"
    },
    "retention_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "portal_visible": {
      "type": "boolean",
      "default": false,
      "description": "Alleen true voor een expliciet gepubliceerde en geautoriseerde CustomerPortalPublication."
    },
    "portal_published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "portal_checksum": {
      "type": [
        "string",
        "null"
      ],
      "description": "Checksum van de gepubliceerde bestandsversie."
    },
    "uploaded_at": {
      "type": "string"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "uploaded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "owner_type",
    "tenant_container_key",
    "owner_container_key",
    "domain",
    "category",
    "file_url",
    "display_filename",
    "download_filename",
    "logical_path",
    "folder_path",
    "uploaded_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
