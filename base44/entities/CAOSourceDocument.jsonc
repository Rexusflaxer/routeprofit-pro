{
  "name": "CAOSourceDocument",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titel van het brondocument"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "cao_page",
        "official_webpage",
        "news_page",
        "news_update",
        "cao_pdf",
        "wage_table_pdf",
        "wage_table_xlsx",
        "pay_periods_pdf",
        "pay_periods_xlsx",
        "fonds_cao_pdf",
        "faq_page",
        "question_answer_page",
        "sociale_commissie_page",
        "sociale_commissie_pdf",
        "sociale_commissie_decision_pdf",
        "protocol_pdf",
        "appendix_pdf",
        "ministerial_registration",
        "other"
      ],
      "description": "Type brondocument"
    },
    "cao_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "CAO sleutel waarvoor deze bron wordt bewaakt"
    },
    "source_category": {
      "type": [
        "string",
        "null"
      ],
      "description": "Vrije broncategorie uit de automation, bijv. hoofd-CAO, loontabel, vraagbaak of sociale commissie"
    },
    "url": {
      "type": "string",
      "description": "URL van het document"
    },
    "canonical_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_official_source": {
      "type": "boolean",
      "default": false,
      "description": "Of de bron als officiele CAO-/branchebron is herkend of aangeleverd"
    },
    "official_source_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ],
      "default": "unknown"
    },
    "payroll_relevance": {
      "type": "string",
      "enum": [
        "critical",
        "supporting",
        "reference",
        "none",
        "unknown"
      ],
      "default": "unknown",
      "description": "Mate waarin deze bron loon-/planningregels kan beinvloeden"
    },
    "monitoring_required": {
      "type": "boolean",
      "default": true,
      "description": "Of de maandelijkse CAO-monitor deze bron actief moet blijven controleren"
    },
    "monitoring_frequency": {
      "type": "string",
      "enum": [
        "monthly",
        "weekly",
        "manual",
        "on_change",
        "none"
      ],
      "default": "monthly"
    },
    "source_priority": {
      "type": [
        "number",
        "null"
      ],
      "description": "Lagere waarde betekent hogere prioriteit bij tegenstrijdige bronnen"
    },
    "discovered_from_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "Pagina of document waarvandaan deze bron is gevonden"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ],
      "description": "SHA-256 hash van de inhoud"
    },
    "hash_algorithm": {
      "type": [
        "string",
        "null"
      ],
      "description": "Hash-algoritme voor content_hash"
    },
    "previous_content_hash": {
      "type": [
        "string",
        "null"
      ],
      "description": "Vorige bekende content hash wanneer een wijziging is gedetecteerd"
    },
    "extracted_text_hash": {
      "type": [
        "string",
        "null"
      ],
      "description": "Hash van de geextraheerde tekst, los van de bestands-hash"
    },
    "etag": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_modified": {
      "type": [
        "string",
        "null"
      ]
    },
    "first_seen_at": {
      "type": "string",
      "description": "Eerste keer gezien (ISO datetime)"
    },
    "last_checked_at": {
      "type": "string",
      "description": "Laatste controle (ISO datetime)"
    },
    "last_changed_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "Laatste wijziging gedetecteerd"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "changed",
        "unreachable",
        "archived"
      ],
      "default": "active"
    },
    "file_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "Opgeslagen kopie van het bestand"
    },
    "extracted_text": {
      "type": [
        "string",
        "null"
      ],
      "description": "Geëxtraheerde tekst"
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "pending",
        "ok",
        "failed",
        "manual_review_required"
      ],
      "default": "pending"
    },
    "extraction_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "parse_warnings": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "Waarschuwingen uit PDF/HTML/parserextractie"
    },
    "coverage_scope": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Welke CAO-onderdelen/regeldomeinen deze bron dekt"
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ],
      "description": "Automation- of Cloudflare-revision waarin deze bron is gezien"
    }
  },
  "required": [
    "title",
    "url",
    "first_seen_at",
    "last_checked_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
