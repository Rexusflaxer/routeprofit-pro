{
  "name": "CollectiveMutationReceipt",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "creation_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "mutation_key_hash": {
      "type": "string"
    },
    "mutation_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_fingerprint": {
      "type": "string"
    },
    "actor_user_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed"
      ],
      "default": "pending"
    },
    "result": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "mutation_key_hash",
    "request_fingerprint",
    "actor_user_id",
    "action",
    "status"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
