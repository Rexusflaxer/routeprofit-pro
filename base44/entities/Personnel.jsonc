      "type": [
        "string",
        "null"
      ]
    },
    "linked_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "initials": {
      "type": [
        "string",
        "null"
      ]
    },
    "legal_first_names": {
      "type": [
        "string",
        "null"
      ]
    },
    "first_name": {
      "type": [
        "string",
        "null"
      ]
    },
