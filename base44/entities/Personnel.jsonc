      "type": [
        "string",
        "null"
      ]
    },
    "last_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "gender": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "male",
        "female",
        "other",
        "unknown",
        null
      ]
    },
    "date_of_birth": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "photo_file_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "email": {
      "type": [
        "string",
        "null"
      ]
    },
    "phone": {
      "type": [
        "string",
        "null"
      ]
    },
    "street_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "house_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "house_number_addition": {
      "type": [
        "string",
        "null"
      ]
    },
    "postal_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "country": {
      "type": "string",
      "default": "Nederland"
    },
    "travel_expense_address_differs": {
      "type": "boolean",
      "default": false
    },
    "travel_street_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "travel_house_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "travel_house_number_addition": {
      "type": [
        "string",
        "null"
      ]
    },
    "travel_postal_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "travel_city": {
      "type": [
        "string",
        "null"
      ]
    },
    "travel_country": {
      "type": [
        "string",
        "null"
      ]
    },
    "place_of_birth": {
      "type": [
        "string",
        "null"
      ]
    },
    "country_of_birth": {
      "type": [
        "string",
        "null"
      ]
    },
    "nationality": {
      "type": [
        "string",
        "null"
      ]
    },
    "payroll_tax_credit_applies": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "payroll_tax_statement_signed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "payroll_tax_statement_file_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "wpbr_required": {
      "type": "boolean",
      "default": false
    },
    "wpbr_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "not_required",
        "not_started",
        "requested",
        "approved",
        "rejected",
        "expired",
        null
      ]
    },
    "wpbr_authority": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "korpschef",
        "kmar",
        "justis",
        "other",
        null
      ]
    },
    "wpbr_permission_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "wpbr_permission_valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "wpbr_permission_valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "function_type": {
      "type": "string",
      "enum": [
        "unknown",
        "surveillant",
        "binnendienst",
        "planner",
        "centralist",
        "verkeersregelaar",
        "brandwacht",
        "installateur",
        "rechercheur",
        "host",
        "other"
      ],
      "default": "unknown"
    },
    "job_title_raw": {
      "type": [
        "string",
        "null"
      ],
      "description": "Vrije functietitel, bijv. Klantrelatie medewerker"
    },
    "employee_type": {
      "type": "string",
      "enum": [
        "zzp",
        "loondienst"
      ],
      "default": "loondienst"
    },
    "contract_type": {
      "type": "string",
      "enum": [
        "fulltime",
        "parttime",
        "0_uren",
        "min_max"
      ]
    },
    "parttime_hours": {
      "type": "number"
    },
    "min_hours": {
      "type": "number"
    },
    "max_hours": {
      "type": "number"
    },
    "cao": {
      "type": "string",
      "enum": [
        "cao_particuliere_beveiliging",
        "cao_evenementen_horecabeveiliging",
        "cao_verkeersregelaars",
        "cao_veiligheidsdomein",
        "eigen_tarief"
      ],
      "default": "cao_particuliere_beveiliging"
    },
    "cao_scale": {
      "type": [
        "number",
        "null"
      ],
      "default": null
    },
    "cao_period": {
      "type": [
        "number",
        "null"
      ],
      "default": null
    },
    "custom_hourly_rate": {
      "type": "number"
    },
    "zzp_hourly_rate_excl_vat": {
      "type": "number"
    },
    "zzp_evening_rate": {
      "type": "number"
    },
    "zzp_night_rate": {
      "type": "number"
    },
    "zzp_weekend_rate": {
      "type": "number"
    },
    "zzp_holiday_rate": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "contract_form": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "bepaalde_tijd",
        "onbepaalde_tijd",
        "oproep",
        "stage",
        "uitzend",
        "payroll",
        "zzp",
        "unknown",
        null
      ]
    },
    "contract_start_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "contract_end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "probation_period_months": {
      "type": [
        "number",
        "null"
      ]
    },
    "probation_period_source_rule_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "probation_override_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "security_role_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "aspirant_beveiliger",
        "beveiliger",
        "leidinggevende",
        "not_applicable",
        "unknown",
        null
      ]
    },
    "industry_seniority_pay_periods": {
      "type": [
        "number",
        "null"
      ]
    },
    "industry_start_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "performs_security_work": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "security_work_percentage": {
      "type": [
        "number",
        "null"
      ]
    },
    "works_airport_schiphol": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "works_cash_value_logistics": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "works_event_or_hospitality_security": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "True als de medewerker normaal evenementen-/horecabeveiliging uitvoert."
    },
    "event_hospitality_cao_applies": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "True als voor deze medewerker de evenementen-/horecabeveiligings-CAO geldt in plaats van CAO PB."
    },
    "cao_scope_profile": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "full_security_worker",
        "non_security_work_article_3_exception",
        "excluded_event_hospitality_security",
        "cash_value_logistics",
        "airport_schiphol",
        "mixed_security_work_manual_review",
        "unknown_manual_review",
        null
      ]
    },
    "cao_function_group": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "objectbeveiliger_receptionist",
        "mobiel_surveillant",
        "winkelsurveillant",
        "brandwacht",
        "geld_waardetransporteur",
        "centralist",
        "non_security_staff",
        "unknown",
        null
      ]
    },
    "cao_function_level": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "aspirant",
        "a",
        "b",
        "c",
        "d",
        "e",
        "leidinggevend",
        "not_applicable",
        "unknown",
        null
      ]
    },
    "cao_applicability_manual_review_required": {
      "type": "boolean",
      "default": true
    },
    "cao_applicability_resolved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "cao_excluded_rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "cao_applicable_rule_profile": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "cao_applicability_source_rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "cao_applicability_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "cao_excluded_articles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "cao_excluded_chapters": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "cao_function_classification": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "cao_function_classification_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "resolved",
        "manual_review_required",
        "not_applicable",
        null
      ],
      "description": "Status van de laatste resolveCaoFunctionClassification aanroep"
    },
    "cao_function_manual_review_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Redenen waarom handmatige review vereist is voor functie-indeling"
    },
    "cao_scale_validation_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "valid",
        "invalid",
        "not_applicable",
        "manual_review_required",
        null
      ],
      "description": "Validatiestatus van cao_scale t.o.v. bijlage 2 classificatie"
    },
    "cao_wage_rate_resolved_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "Tijdstip waarop uurloon succesvol is opgezocht in de loontabel"
    },
    "payroll_final_allowed": {
      "type": "boolean",
      "default": false,
      "description": "True als loonberekening/payroll-export definitief mag zijn (geen openstaande reviews)"
    },
    "company_car_license_plate": {
      "type": "string"
    },
    "company_car_brand": {
      "type": "string"
    },
    "company_car_model": {
      "type": "string"
    },
    "company_car_year": {
      "type": "number"
    },
    "company_car_fiscal_value": {
      "type": "number"
    },
    "company_car_bijtelling_percentage": {
      "type": "number",
      "default": 16
    },
    "company_car_fuel_type": {
      "type": "string",
      "enum": [
        "benzine",
        "diesel",
        "elektrisch",
        "hybride",
        "lpg"
      ]
    },
    "company_car_monthly_lease_cost": {
      "type": "number"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "name",
    "function_type",
    "employee_type"
  ]
}
