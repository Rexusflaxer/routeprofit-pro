{
  "name": "Personnel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Weergavenaam (backwards compatible)"
    },
    "personnel_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "onboarding",
        "active",
        "inactive",
        "archived"
      ],
      "default": "draft"
    },
    "hr_completeness_status": {
      "type": "string",
      "enum": [
        "incomplete",
        "needs_review",
        "complete"
      ],
      "default": "incomplete"
    },
    "primary_company_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "login_email": {
      "type": [
        "string",
        "null"
      ]
    },
    "linked_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
