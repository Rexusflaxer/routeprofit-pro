{
  "name": "Personnel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Weergavenaam (backwards compatible)"
    },
    "personnel_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "onboarding",
        "active",
        "inactive",
        "archived"
      ],
      "default": "draft"
    },
    "hr_completeness_status": {
      "type": "string",
      "enum": [
        "incomplete",
        "needs_review",
        "complete"
      ],
      "default": "incomplete"
    },
    "primary_company_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "login_email": {
      "type": [
        "string",
        "null"
      ]
    },
    "linked_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "linked_user_email": {
      "type": [
        "string",
        "null"
      ]
    },
    "linked_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "initials": {
      "type": [
        "string",
        "null"
      ]
    },
    "legal_first_names": {
      "type": [
        "string",
        "null"
      ]
    },
    "first_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "call_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "name_prefix": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "gender": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "male",
        "female",
        "other",
        "unknown",
        null
      ]
    },
    "date_of_birth": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "photo_file_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "email": {
      "type": [
        "string",
        "null"
      ]
    },
    "phone": {
      "type": [
        "string",
        "null"
      ]
    },
    "street_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "house_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "house_number_addition": {
      "type": [
        "string",
        "null"
      ]
    },
    "postal_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "country": {
      "type": "string",
      "default": "Nederland"
    },
    "travel_expense_address_differs": {
      "type": "boolean",
      "default": false
    },
    "travel_street_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "travel_house_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "travel_house_number_addition": {
      "type": [
        "string",
        "null"
      ]
    },
    "travel_postal_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "travel_city": {
      "type": [
        "string",
        "null"
      ]
    },
    "travel_country": {
      "type": [
        "string",
        "null"
      ]
    },
    "place_of_birth": {
      "type": [
        "string",
        "null"
      ]
    },
    "country_of_birth": {
      "type": [
        "string",
        "null"
      ]
    },
    "nationality": {
      "type": [
        "string",
        "null"
      ]
    },
    "payroll_tax_credit_applies": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "payroll_tax_statement_signed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "payroll_tax_statement_file_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "wpbr_required": {
      "type": "boolean",
      "default": false
    },
    "wpbr_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "not_required",
        "not_started",
        "requested",
        "approved",
        "rejected",
        "expired",
        null
      ]
    },
    "wpbr_authority": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "korpschef",
        "kmar",
        "justis",
        "other",
        null
      ]
    },
    "wpbr_permission_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "wpbr_permission_valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "wpbr_permission_valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "function_type": {
      "type": "string",
      "enum": [
        "surveillant",
        "binnendienst",
        "planner",
        "centralist",
        "verkeersregelaar",
        "brandwacht",
        "installateur",
        "rechercheur",
        "host",
        "other"
      ],
      "default": "surveillant"
    },
    "employee_type": {
      "type": "string",
      "enum": [
        "zzp",
        "loondienst"
      ],
      "default": "loondienst"
    },
    "contract_type": {
      "type": "string",
      "enum": [
        "fulltime",
        "parttime",
        "0_uren",
        "min_max"
      ]
    },
    "parttime_hours": {
      "type": "number"
    },
    "min_hours": {
      "type": "number"
    },
    "max_hours": {
      "type": "number"
    },
    "cao": {
      "type": "string",
      "enum": [
        "cao_particuliere_beveiliging",
        "eigen_tarief"
      ],
      "default": "cao_particuliere_beveiliging"
    },
    "cao_scale": {
      "type": "number",
      "default": 3
    },
    "cao_period": {
      "type": "number",
      "default": 0
    },
    "custom_hourly_rate": {
      "type": "number"
    },
    "zzp_hourly_rate_excl_vat": {
      "type": "number"
    },
    "zzp_evening_rate": {
      "type": "number"
    },
    "zzp_night_rate": {
      "type": "number"
    },
    "zzp_weekend_rate": {
      "type": "number"
    },
    "zzp_holiday_rate": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "contract_form": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "bepaalde_tijd",
        "onbepaalde_tijd",
        "oproep",
        "stage",
        "uitzend",
        "zzp",
        "unknown",
        null
      ],
      "description": "Contractvorm conform CAO PB"
    },
    "contract_start_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "contract_end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "probation_period_months": {
      "type": [
        "number",
        "null"
      ],
      "description": "Proeftijd in maanden conform CAO-berekening"
    },
    "probation_period_source_rule_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Bronregel voor de proeftijd, bijv. CAO-PB-2024-R0315"
    },
    "probation_override_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Reden voor handmatige afwijking van de CAO-proeftijdberekening"
    },
    "security_role_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "aspirant_beveiliger",
        "beveiliger",
        "leidinggevende",
        "not_applicable",
        "unknown",
        null
      ],
      "description": "Beveiligingsfunctie-status conform CAO PB"
    },
    "industry_seniority_pay_periods": {
      "type": [
        "number",
        "null"
      ],
      "description": "Brancheancienniteit in loonperioden"
    },
    "industry_start_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Startdatum brancheancienniteit"
    },
    "company_car_license_plate": {
      "type": "string"
    },
    "company_car_brand": {
      "type": "string"
    },
    "company_car_model": {
      "type": "string"
    },
    "company_car_year": {
      "type": "number"
    },
    "company_car_fiscal_value": {
      "type": "number"
    },
    "company_car_bijtelling_percentage": {
      "type": "number",
      "default": 16
    },
    "company_car_fuel_type": {
      "type": "string",
      "enum": [
        "benzine",
        "diesel",
        "elektrisch",
        "hybride",
        "lpg"
      ]
    },
    "company_car_monthly_lease_cost": {
      "type": "number"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "name",
    "function_type",
    "employee_type"
  ]
}