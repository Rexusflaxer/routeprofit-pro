    "code_hash": {"type": "string"},
    "state_hash": {"type": "string"},
    "challenge": {"type": "string"},
    "ciphertext": {"type": "string"},
    "iv": {"type": "string"},
    "expires_at": {"type": "string", "format": "date-time"},
    "consumed_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"type": "string", "enum": ["pending", "consumed"], "default": "pending"},
    "version": {"type": "number", "default": 1}
  },
  "required": ["app_id", "user_id", "code_hash", "state_hash", "challenge", "ciphertext", "iv", "expires_at", "status", "version"],
  "rls": {
    "create": {"user_condition": {"id": "__desktop_service_only__"}},
