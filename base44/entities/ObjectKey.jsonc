{
  "name": "ObjectKey",
  "type": "object",
  "properties": {
    "key_type": {
      "type": "string",
      "enum": [
        "key",
        "tag",
        "remote",
        "access_card"
      ]
    },
    "brand": {
      "type": "string",
      "description": "Merk of fabrikant van het toegangsmiddel"
    },
    "serial_number": {
      "type": [
        "string",
        "null"
      ],
      "description": "Serie-, pas-, tag- of fabrikantnummer op het toegangsmiddel"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_storage",
        "missing",
        "out_of_service"
      ],
      "default": "in_storage"
    }
  },
  "required": [
    "key_type",
    "brand",
    "status"
  ]
}