{
  "name": "PersonnelProfile",
  "type": "object",
  "properties": {
    "personnel_id": {
      "type": "string",
      "description": "ID van de medewerker"
    },
    "competencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "level": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "source": {
            "type": "string",
            "enum": [
              "catalog",
              "custom"
            ]
          }
        },
        "required": [
          "key",
          "label",
          "category",
          "level"
        ]
      },
      "default": [],
      "description": "Vaardigheden, talen en persoonlijke competenties met beheersingsniveau"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Legacy talenveld"
    },
    "software_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "software": {
            "type": "string"
          },
          "level": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Legacy softwarevaardighedenveld"
    },
    "cv_file_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "CV bestand URL"
    },
    "cv_file_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "ManagedFile ID van de CV"
    },
    "cv_download_filename": {
      "type": [
        "string",
        "null"
      ],
      "description": "Downloadbestandsnaam voor de CV"
    },
    "cv_uploaded_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Wanneer de CV is geüpload"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Opmerkingen"
    }
  },
  "required": [
    "personnel_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
