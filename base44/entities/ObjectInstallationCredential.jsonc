{
  "name": "ObjectInstallationCredential",
  "type": "object",
  "properties": {
    "customer_id": { "type": "string" },
    "object_id": { "type": "string" },
    "installation_id": { "type": "string" },
    "credential_type": {
      "type": "string",
      "enum": ["bundle", "switching_code", "reset_code", "operator_code", "service_code"]
    },
    "credential_types": {
      "type": "array",
      "items": { "type": "string", "enum": ["switching_code", "reset_code", "operator_code", "service_code"] },
      "default": []
    },
    "encrypted_value": { "type": "string" },
    "encryption_iv": { "type": "string" },
    "encryption_algorithm": { "type": "string", "enum": ["AES-256-GCM"] },
    "encryption_key_id": { "type": "string" },
    "encryption_key_source": {
      "type": ["string", "null"],
      "enum": ["dedicated", "managed_file_hkdf", "managed_file_legacy", null],
      "description": "Bepaalt onafhankelijk van de actuele omgevingsconfiguratie welke sleutelbron voor decryptie nodig is"
    },
    "status": { "type": "string", "enum": ["stored", "active", "superseded", "archived"], "default": "stored" },
    "superseded_by_id": { "type": ["string", "null"] },
    "created_by_user_id": { "type": ["string", "null"] },
    "creation_idempotency_key": { "type": ["string", "null"] },
    "version": { "type": "number", "default": 1 }
  },
  "required": ["customer_id", "object_id", "installation_id", "credential_type", "encrypted_value", "encryption_iv", "encryption_algorithm", "encryption_key_id", "status"],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
