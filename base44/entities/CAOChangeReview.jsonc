{
  "name": "CAOChangeReview",
  "type": "object",
  "properties": {
    "import_run_id": {
      "type": "string"
    },
    "cao_configuration_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "rule_key": {
      "type": "string"
    },
    "field_path": {
      "type": "string",
      "description": "Bijv. wage_scales.3.2"
    },
    "old_value": {
      "type": [
        "object",
        "string",
        "number",
        "null"
      ],
      "additionalProperties": true
    },
    "new_value": {
      "type": [
        "object",
        "string",
        "number",
        "null"
      ],
      "additionalProperties": true
    },
    "source_document_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_reference": {
      "type": [
        "string",
        "null"
      ],
      "description": "Bijv. Bijlage 4, p.87"
    },
    "change_type": {
      "type": "string",
      "enum": [
        "added",
        "changed",
        "removed",
        "needs_mapping",
        "needs_legal_review"
      ],
      "default": "changed"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "owner_approved",
        "owner_rejected",
        "applied",
        "superseded"
      ],
      "default": "proposed"
    },
    "approval_source": {
      "type": [
        "string",
        "null"
      ],
      "description": "Herkomst goedkeuring"
    },
    "approved_by_owner_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "codex_thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cloudflare_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "import_run_id",
    "rule_key",
    "field_path",
    "change_type"
  ]
}