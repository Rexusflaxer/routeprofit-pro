{
  "name": "CAOChangeReview",
  "type": "object",
  "properties": {
    "import_run_id": {
      "type": "string"
    },
    "cao_configuration_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cao_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "CAO sleutel waarop deze wijziging ziet, bijv. cao_particuliere_beveiliging."
    },
    "rule_key": {
      "type": "string"
    },
    "field_path": {
      "type": "string",
      "description": "Bijv. wage_scales.3.2"
    },
    "old_value": {
      "type": [
        "object",
        "string",
        "number",
        "null"
      ],
      "additionalProperties": true
    },
    "new_value": {
      "type": [
        "object",
        "string",
        "number",
        "null"
      ],
      "additionalProperties": true
    },
    "source_document_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_reference": {
      "type": [
        "string",
        "null"
      ],
      "description": "Bijv. Bijlage 4, p.87"
    },
    "change_type": {
      "type": "string",
      "enum": [
        "added",
        "changed",
        "removed",
        "needs_mapping",
        "needs_legal_review"
      ],
      "default": "changed"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Datum vanaf wanneer deze wijziging inhoudelijk geldt."
    },
    "effective_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "effective_from_source": {
      "type": [
        "string",
        "null"
      ],
      "description": "Herkomst van de gebruikte ingangsdatum, bijv. change.effective_from, change.valid_from, change.applies_from of candidate_configuration.valid_from."
    },
    "effective_from_inferred": {
      "type": "boolean",
      "default": false,
      "description": "True als effective_from is afgeleid uit de CAO-configuratie en niet expliciet op de wijziging stond."
    },
    "effective_date_manual_review_required": {
      "type": "boolean",
      "default": false,
      "description": "True als de ingangsdatum/werkingsperiode niet veilig automatisch kan worden toegepast op historische payroll."
    },
    "effective_date_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Auditnotities over ontbrekende, afgeleide of conflicterende ingangsdata."
    },
    "payroll_impact": {
      "type": "boolean",
      "default": false,
      "description": "True als wijziging loon, planning, contractregels of payrollcorrecties kan raken."
    },
    "retroactive": {
      "type": "boolean",
      "default": false,
      "description": "True als effective_from vóór de eigenaar-goedkeuring ligt."
    },
    "correction_required": {
      "type": "boolean",
      "default": false,
      "description": "True als een retroactieve payroll-impact wijziging correctie in een toekomstige loonrun vereist."
    },
    "correction_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "not_required",
        "candidate",
        "queued",
        "applied",
        "manual_review_required",
        "skipped_no_affected_run",
        "superseded",
        null
      ],
      "default": "not_required"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "owner_approved",
        "owner_rejected",
        "applied",
        "superseded"
      ],
      "default": "proposed"
    },
    "approval_source": {
      "type": [
        "string",
        "null"
      ],
      "description": "Herkomst goedkeuring"
    },
    "approved_by_owner_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "codex_thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cloudflare_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_deduplication_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Stabiele sleutel voor idempotente CAOChangeReview-upsert, gebaseerd op idempotency_key + cao/rule/field/change/effective/value-signature."
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "import_run_id",
    "rule_key",
    "field_path",
    "change_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
