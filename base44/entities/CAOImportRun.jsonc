{
  "name": "CAOImportRun",
  "type": "object",
  "properties": {
    "started_at": {
      "type": "string",
      "description": "Starttijd (ISO datetime)"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "manual",
        "scheduled",
        "source_changed",
        "codex_automation",
        "cloudflare_relay",
        "cloudflare_pull",
        "owner_migration"
      ],
      "default": "cloudflare_pull"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "completed_with_review",
        "failed"
      ],
      "default": "running"
    },
    "approval_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "proposed",
        "owner_approved",
        "owner_rejected",
        null
      ],
      "description": "Goedkeuringsstatus van de payload"
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Idempotency sleutel van de ingest payload"
    },
    "codex_thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cloudflare_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_document_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "detected_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "created_configuration_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_review_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_message": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "started_at",
    "status",
    "trigger_type"
  ]
}