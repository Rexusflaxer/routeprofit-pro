{
  "name": "CAOImportRun",
  "type": "object",
  "properties": {
    "started_at": {
      "type": "string",
      "description": "Starttijd (ISO datetime)"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "manual",
        "scheduled",
        "source_changed",
        "codex_automation",
        "cloudflare_relay",
        "cloudflare_pull",
        "owner_migration"
      ],
      "default": "cloudflare_pull"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "completed_with_review",
        "failed"
      ],
      "default": "running"
    },
    "approval_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "proposed",
        "owner_approved",
        "owner_rejected",
        null
      ],
      "description": "Goedkeuringsstatus van de payload"
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Idempotency sleutel van de ingest payload"
    },
    "codex_thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cloudflare_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_document_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "detected_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "created_configuration_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_review_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reused_review_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CAOChangeReview IDs die idempotent zijn hergebruikt in plaats van opnieuw aangemaakt."
    },
    "superseded_review_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Duplicate CAOChangeReview IDs die tijdens import op superseded zijn gezet."
    },
    "archived_same_start_configuration_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Oudere actieve CAOConfiguration IDs met dezelfde cao_key + valid_from die tijdens sync/ingest zijn gearchiveerd."
    },
    "created_correction_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CAOPayrollCorrection IDs die naar aanleiding van deze import zijn aangemaakt of bijgewerkt."
    },
    "correction_queue_summary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Samenvatting van de retroactieve payrollcorrectie-queue na CAO-import."
    },
    "payroll_readiness_status": {
      "type": [
        "string",
        "null"
      ],
      "description": "Payroll-readiness status van de geïmporteerde CAO-configuratie."
    },
    "coverage_gate": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Snapshot van de coverage-gate die tijdens import/sync is berekend."
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_message": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "started_at",
    "status",
    "trigger_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
