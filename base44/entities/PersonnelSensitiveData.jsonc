{
  "name": "PersonnelSensitiveData",
  "type": "object",
  "properties": {
    "personnel_id": {
      "type": "string",
      "description": "ID van de medewerker"
    },
    "bsn": {
      "type": [
        "string",
        "null"
      ],
      "description": "Legacy plaintext BSN. Nieuwe records gebruiken bsn_encrypted_payload."
    },
    "bsn_masked": {
      "type": [
        "string",
        "null"
      ],
      "description": "Gemaskerde BSN-weergave, bijv. *** *** 123"
    },
    "bsn_encrypted_payload": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Applicatie-level versleutelde BSN payload"
    },
    "sensitive_payload_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity_verified_at_hire": {
      "type": "boolean",
      "default": false
    },
    "identity_verified_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity_verified_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity_copy_retention_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "payroll_notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "personnel_id"
  ]
}
