{
  "name": "PersonnelQualification",
  "type": "object",
  "properties": {
    "personnel_id": {
      "type": "string"
    },
    "company_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "qualification_type": {
      "type": "string",
      "enum": [
        "beveiliger_2",
        "beveiliger_3",
        "mbo_beveiliger",
        "mbo_beveiliger_in_opleiding",
        "coordinator_beveiliging",
        "svpb_basisdiploma_beveiliging",
        "svpb_vakdiploma_beveiliging",
        "svpb_kaderdiploma_beveiliging",
        "permanente_ontheffing_minister",
        "horecaportier",
        "voetbalsteward",
        "verkeersregelaar",
        "ehbo",
        "bhv",
        "brandwacht",
        "rijksdiploma_brandwacht",
        "rijksdiploma_brandwacht_1e_klas",
        "rijksdiploma_hoofdbrandwacht",
        "rijbewijs_c",
        "detailhandel",
        "certificaat_winkelsurveillance",
        "certificaat_beveiliging_b",
        "certificaat_beveiliging_c",
        "centralist_boca",
        "centralist_boca_in_opleiding",
        "centralist_voca",
        "leidinggeven_pb",
        "branchediploma_coordinator_beveiliging",
        "alarminstallateur",
        "particulier_onderzoeker",
        "other"
      ]
    },
    "name": {
      "type": "string"
    },
    "issuer": {
      "type": [
        "string",
        "null"
      ]
    },
    "certificate_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "cao_source_rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "CAO-regel-id's waarop deze kwalificatie/diplomakoppeling is gebaseerd, bijvoorbeeld bijlage 3."
    },
    "document_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "verified",
        "rejected",
        "expired"
      ],
      "default": "pending_review"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "personnel_id",
    "qualification_type",
    "name"
  ]
}
