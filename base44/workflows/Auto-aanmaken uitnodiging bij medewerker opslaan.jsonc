{
  "name": "Auto-aanmaken uitnodiging bij medewerker opslaan",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.data.linked_user_id == null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Personnel"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_aanmaken_uitnodiging_bij_medewerker_opslaan",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onPersonnelSaved",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onPersonnelSaved"
  }
}