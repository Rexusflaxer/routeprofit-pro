{
  "name": "CAO Cloudflare Sync - Wekelijks",
  "description": "Haalt elk uur de owner-approved CAO op uit Cloudflare en synchroniseert naar Base44. Geen klant-UI \u2014 volledig automatisch.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 4 * * 1",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "cao_cloudflare_sync_wekelijks",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncCaoFromCloudflare",
            "args": {
              "force": false,
              "trigger_source": "scheduled_weekly"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncCaoFromCloudflare"
  }
}